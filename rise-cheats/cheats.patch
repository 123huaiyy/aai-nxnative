+enum { RISE_CHEAT_WORD = 0x12c7bfc0, RISE_DAMAGE_SITE = 0x0501adac, RISE_COMBAT_MASK = 0x1f };
+static void rise_cheats_init(void) {
+    const module_t *m = g_main_mod;
+    if (!m || !m->base || strcmp(m->build_id, "d2fd97779381fb9a836c674192d0133a") ||
+        m->key_page_off != 0x12c7c000 || m->size < RISE_CHEAT_WORD + sizeof(unsigned)) return;
+    uint32_t entry;
+    memcpy(&entry, m->base + RISE_DAMAGE_SITE, sizeof entry);
