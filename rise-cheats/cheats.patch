+void dm_rise_cheats_toggle(unsigned mask) {
+    if (!mask || (mask & (mask - 1)) || (mask & ~RISE_COMBAT_MASK)) return;
+    pthread_mutex_lock(&g_lock);
+    _Atomic unsigned *bits = atomic_load(&g_rise_switches);
+    if (bits && atomic_load(&g_master)) atomic_fetch_xor(bits, mask);
+    pthread_mutex_unlock(&g_lock);
+}
