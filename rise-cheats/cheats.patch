+private func gameCheatsMenu() -> UIMenu? {
+    guard !String(cString: dm_cheats_dir_path()).isEmpty else { return nil }
+    let build = String(cString: dm_cheats_build())
+    let loaded = dm_cheats_found() != 0
+    let master = dm_cheats_master() != 0
+    let toggle = UIAction(title: "启用单机金手指", attributes: loaded ? [] : .disabled, state: master ? .on : .off) { _ in
+        dm_cheats_master_set(dm_cheats_master() == 0 ? 1 : 0)
+    }
+    let reload = UIAction(title: "重新读取作弊码", image: UIImage(systemName: "arrow.clockwise")) { _ in
+        dm_cheats_master_set(0)
+        dm_cheats_reload()
+    }
+    var rows: [UIMenuElement] = [toggle]
+    if !loaded {
+        let file = build.isEmpty ? "当前版本的代码文件" : "\(build).txt"
+        rows.append(UIAction(title: "请放入 Documents/cheats", subtitle: file, attributes: .disabled) { _ in })
+    }
+    for i in 0..<dm_cheats_ncheats() where dm_ios_cheat_visible(i) {
+        let name = String(cString: dm_cheat_name_at(i))
+        let title = name.hasSuffix(" - on") ? String(name.dropLast(5)) : name
+        if title.isEmpty { continue }
+        let kind = dm_cheat_kind_at(i)
+        let pending = String(cString: dm_cheat_why_at(i)).trimmingCharacters(in: .whitespacesAndNewlines)
+        let detail = pending.isEmpty ? (kind == 1 ? "主代码，随总开关运行" : nil) : pending
+        let attrs: UIMenuElement.Attributes = kind == 0 && master ? [] : .disabled
+        let selected = master && kind < 2 && (dm_cheat_on_at(i) != 0 || kind == 1)
+        rows.append(UIAction(title: title, subtitle: detail, attributes: attrs, state: selected ? .on : .off) { _ in
+            if dm_cheats_master() != 0 { dm_cheat_toggle(i) }
+        })
+    }
+    rows.append(reload)
+    return UIMenu(title: "金手指", subtitle: build.isEmpty ? nil : build, children: rows)
 }
 
