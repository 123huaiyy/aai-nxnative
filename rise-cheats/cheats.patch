+int dm_rise_cheats_available(void) { return atomic_load(&g_rise_switches) != NULL; }
+unsigned dm_rise_cheats_flags(void) {
+    _Atomic unsigned *bits = atomic_load(&g_rise_switches);
+    return bits ? atomic_load(bits) : 0;
