+++ b/app/Madeira/DarkestPort.swift
@@ -0,0 +1,276 @@
+import Foundation
+import SwiftUI
+import UIKit
+import UniformTypeIdentifiers
+
+enum DarkestPort {
+    static var documents: URL {
+        FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
+    }
+    static var root: URL { documents.appendingPathComponent("DarkestDungeon", isDirectory: true) }
+    static var game: URL { root.appendingPathComponent("game", isDirectory: true) }
+    static var mods: URL { root.appendingPathComponent("mods", isDirectory: true) }
+    static var saves: URL { root.appendingPathComponent("saves", isDirectory: true) }
+    static var logs: URL { root.appendingPathComponent("logs", isDirectory: true) }
+    static let driveName = "DarkestDungeon"
+    private static let candidates = [
+        "_windowsnosteam/win64/Darkest.exe", "_windows/win64/Darkest.exe",
+    ]
+
+    struct Failure: LocalizedError {
+        let errorDescription: String?
+        init(_ message: String) { errorDescription = message }
+    }
+
+    static func makeFolders() throws {
+        let fm = FileManager.default
+        for folder in [root, game, mods, saves, logs] {
+            guard (try? fm.destinationOfSymbolicLink(atPath: folder.path)) == nil else {
+                throw Failure("请将 \(folder.lastPathComponent) 恢复为普通目录后重试。")
+            }
+            try fm.createDirectory(at: folder, withIntermediateDirectories: true)
+        }
+    }
+
+    static func relativeGamePath(_ url: URL) -> String? {
+        let prefix = game.resolvingSymlinksInPath().standardizedFileURL.path + "/"
+        let path = url.resolvingSymlinksInPath().standardizedFileURL.path
+        guard path.hasPrefix(prefix) else { return nil }
+        return String(path.dropFirst(prefix.count))
+    }
+
+    /// Check the actual casing first, then find a unique case-insensitive
+    /// match (Files may receive a PC folder with differently cased names).
+    static func findExecutable() -> URL? {
+        let fm = FileManager.default
+        for candidate in candidates {
+            var directory = game
+            var found = true
+            for part in candidate.split(separator: "/").map(String.init) {
+                let exact = directory.appendingPathComponent(part)
+                if fm.fileExists(atPath: exact.path) {
+                    directory = exact
+                } else {
+                    let matches = (try? fm.contentsOfDirectory(atPath: directory.path))?
+                        .filter { $0.caseInsensitiveCompare(part) == .orderedSame } ?? []
+                    guard matches.count == 1 else { found = false; break }
+                    directory.appendPathComponent(matches[0])
+                }
+            }
+            if found && relativeGamePath(directory) != nil &&
+                (try? directory.resourceValues(forKeys: [.isRegularFileKey]).isRegularFile) == true {
+                return directory
+            }
+        }
+        return nil
+    }
+
+    /// Relative symlinks survive a container UUID change. When a PC copy or a
+    /// previous Wine profile already has data here, keep the original and
+    /// copy its missing children into the new location before installing the
+    /// link. Conflicting filenames remain available in the recovery folder.
+    private static func mount(_ link: URL, to target: URL, migrate: Bool) throws {
+        let fm = FileManager.default
+        let parent = link.deletingLastPathComponent()
+        let sandbox = documents.resolvingSymlinksInPath()
+        let parentPath = parent.resolvingSymlinksInPath().path
+        let targetPath = target.resolvingSymlinksInPath().path
+        guard parentPath.hasPrefix(sandbox.path + "/"), targetPath.hasPrefix(sandbox.path + "/") else {
+            throw Failure("挂载路径超出了应用的文件目录。")
+        }
+        try fm.createDirectory(at: parent, withIntermediateDirectories: true)
+        let oldLink = try? fm.destinationOfSymbolicLink(atPath: link.path)
+        if oldLink != nil && link.resolvingSymlinksInPath().path == targetPath { return }
+        var backup: URL?
+        if oldLink != nil || fm.fileExists(atPath: link.path) {
+            guard migrate else { throw Failure("Wine 映射路径已被占用：\(link.lastPathComponent)。") }
+            let recovery = root.appendingPathComponent("recovery", isDirectory: true)
+            try fm.createDirectory(at: recovery, withIntermediateDirectories: true)
+            guard recovery.resolvingSymlinksInPath().path.hasPrefix(sandbox.path + "/") else {
+                throw Failure("恢复目录超出了应用的文件目录。")
+            }
+            let copy = recovery.appendingPathComponent(link.lastPathComponent + "-" + UUID().uuidString)
+            if oldLink == nil {
+                for item in try fm.contentsOfDirectory(at: link, includingPropertiesForKeys: [.isSymbolicLinkKey]) {
+                    let dest = target.appendingPathComponent(item.lastPathComponent)
+                    if try item.resourceValues(forKeys: [.isSymbolicLinkKey]).isSymbolicLink != true,
+                       !fm.fileExists(atPath: dest.path),
+                       (try? fm.destinationOfSymbolicLink(atPath: dest.path)) == nil {
+                        try fm.copyItem(at: item, to: dest)
+                    }
+                }
+            }
+            try fm.moveItem(at: link, to: copy)
+            backup = copy
+        }
+        let from = parent.resolvingSymlinksInPath().pathComponents
+        let to = target.resolvingSymlinksInPath().pathComponents
+        let shared = zip(from, to).prefix(while: { $0.0 == $0.1 }).count
+        let relative = (Array(repeating: "..", count: from.count - shared) + to.dropFirst(shared)).joined(separator: "/")
+        do {
+            try fm.createSymbolicLink(atPath: link.path, withDestinationPath: relative)
+        } catch {
+            if let backup { try? fm.moveItem(at: backup, to: link) }
+            throw error
+        }
+    }
+
+    static func prepare(executable: URL) throws -> LibraryEntry {
+        try makeFolders()
+        guard let relative = relativeGamePath(executable),
+              executable.pathExtension.lowercased() == "exe",
+              (try? executable.resourceValues(forKeys: [.isRegularFileKey]).isRegularFile) == true else {
+            throw Failure("请选择游戏目录里的 Windows .exe 文件。")
+        }
+        let fm = FileManager.default
+        let prefix = documents.appendingPathComponent("wine", isDirectory: true)
+        madeira_seed_prefix_if_needed(prefix.path)
+        let drive = LibraryEntry.hostDrive
+        guard fm.fileExists(atPath: prefix.appendingPathComponent("system.reg").path) else {
+            throw Failure("Wine 首次初始化失败，请查看日志。")
+        }
+        try mount(drive.appendingPathComponent(driveName), to: game, migrate: false)
+        var entry = try LibraryModel.inspect(executable)
+        guard entry.relativePath == driveName + "/" + relative else {
+            throw Failure("Wine 的游戏目录映射不一致。")
+        }
+        try mount(game.appendingPathComponent("mods"), to: mods, migrate: true)
+        let users = drive.appendingPathComponent("users", isDirectory: true)
+        let unixUser = getpwuid(getuid()).map { String(cString: $0.pointee.pw_name) } ?? ""
+        let names = Set(["madeira", "mobile", unixUser, ProcessInfo.processInfo.environment["USER"] ?? ""])
+        for name in names.sorted() where !name.isEmpty && name != "." && name != ".." &&
+            !name.contains("/") && !name.contains("\\") {
+            let folder = users.appendingPathComponent(name).appendingPathComponent("Documents")
+            if (try? fm.destinationOfSymbolicLink(atPath: folder.path)) != nil,
+               !fm.fileExists(atPath: folder.path) {
+                // The upstream tarball used a dangling developer-machine link.
+                try fm.removeItem(at: folder)
+            }
+            try mount(folder.appendingPathComponent("Darkest"), to: saves, migrate: true)
+        }
+        // A Windows Steam copy may use userdata as soon as Steam has created
+        // its account directory. Keep each account in its own save folder.
+        for install in ["Program Files (x86)/Steam", "Program Files/Steam"] {
+            let data = drive.appendingPathComponent(install).appendingPathComponent("userdata")
+            for account in (try? fm.contentsOfDirectory(atPath: data.path)) ?? []
+                where !account.isEmpty && account.utf8.allSatisfy({ (48...57).contains($0) }) {
+                let base = data.appendingPathComponent(account).appendingPathComponent("262060")
+                let steam = saves.appendingPathComponent("steam").appendingPathComponent(account)
+                try fm.createDirectory(at: steam, withIntermediateDirectories: true)
+                try mount(base.appendingPathComponent("remote"), to: steam, migrate: true)
+            }
+        }
+        entry.title = "暗黑地牢"
+        entry.resolution = ResolutionChoices.defaultValue
+        entry.display = DisplayMode.aspect.rawValue
+        entry.fpsMode = 1
+        return entry
+    }
+
+    static func uses(_ entry: LibraryEntry?) -> Bool {
+        entry?.relativePath.hasPrefix(driveName + "/") == true
+    }
+
+    static func configureGraphics() throws {
+        let fm = FileManager.default
+        let gl = Bundle.main.bundleURL.appendingPathComponent("gl")
+        guard ["libOSMesa.dylib", "libMoltenVK.dylib"].allSatisfy({
+            fm.fileExists(atPath: gl.appendingPathComponent($0).path)
+        }) else { throw Failure("本 IPA 缺少桌面 OpenGL 运行库，请使用含 Zink 和 MoltenVK 的构建。") }
+        let cache = fm.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("dd_shader_cache", isDirectory: true)
+        try fm.createDirectory(at: cache, withIntermediateDirectories: true)
+        setenv("MADEIRA_GL_BACKEND", "zink", 1)
+        setenv("MADEIRA_GL_VULKAN", "moltenvk", 1)
+        setenv("MESA_SHADER_CACHE_DIR", cache.path, 1)
+        setenv("MESA_SHADER_CACHE_MAX_SIZE", "256M", 1)
+        setenv("MVK_CONFIG_LOG_LEVEL", "1", 1)
+        setenv("MADEIRA_GL_PERF", "0", 1)
+        setenv("MADEIRA_GL_FPS_CAP", "1", 1)
+        setenv("MADEIRA_DEBUG_VERBOSE", "0", 1)
+    }
+}
+
+struct DarkestLaunchView: View {
+    let play: (URL, String) -> Void
+    let enableJIT: () -> Void
+    @ObservedObject private var library = LibraryModel.shared
+    @AppStorage("ddExecutable") private var selected = ""
+    @AppStorage("ddArguments") private var arguments = ""
+    @State private var executable: URL?
+    @State private var showFiles = false
+    @State private var showJIT = false
+    @State private var showMemory = false
+
+    private func scan() {
+        do {
+            try DarkestPort.makeFolders()
+            if !selected.isEmpty {
+                let manual = DarkestPort.game.appendingPathComponent(selected)
+                if DarkestPort.relativeGamePath(manual) == selected &&
+                    FileManager.default.fileExists(atPath: manual.path) {
+                    executable = manual
+                    return
+                }
+            }
+            executable = DarkestPort.findExecutable()
+        } catch { library.error = error.localizedDescription }
+    }
+
+    var body: some View {
+        Form {
+            Section("游戏文件") {
+                if let executable, let path = DarkestPort.relativeGamePath(executable) {
+                    Text(path).font(.footnote.monospaced()).textSelection(.enabled)
+                } else {
+                    Text("打开「文件」→「我的 iPhone」→「暗黑地牢」→ DarkestDungeon → game。把 PC 游戏文件夹内的全部文件和子目录复制进 game，使 _windowsnosteam 或 _windows 直接位于 game 下。")
+                }
+                Button("重新扫描") { selected = ""; scan() }
+                Button("手动选择 .exe") { showFiles = true }
+            }
+            Section("启动") {
+                TextField("自定义命令行参数", text: $arguments)
+                    .textInputAutocapitalization(.never).autocorrectionDisabled()
+                Button("开始游戏") {
+                    guard let executable else { return }
+                    guard StikJITHelper.ready else { showJIT = true; return }
+                    guard EntitlementStatus.check().increasedMemory else { showMemory = true; return }
+                    play(executable, arguments)
+                }
+                .disabled(executable == nil)
+                Button("启用 JIT", action: enableJIT)
+                Text(EntitlementStatus.check().increasedMemory ? "Memory+ 已启用" : "Memory+ 未启用")
+                    .foregroundStyle(.secondary)
+            }
+            Section("Mod 与存档") {
+                Text("将每个解压后的 PC 数据 Mod 文件夹放进 DarkestDungeon/mods，结束当前会话后重新启动游戏。存档在 DarkestDungeon/saves，删除应用前请通过「文件」备份。")
+            }
+        }
+        .onAppear(perform: scan)
+        .onReceive(NotificationCenter.default.publisher(for: UIApplication.didBecomeActiveNotification)) { _ in scan() }
+        .fileImporter(isPresented: $showFiles, allowedContentTypes: [UTType(filenameExtension: "exe") ?? .data]) { result in
+            do {
+                let url = try result.get()
+                let accessing = url.startAccessingSecurityScopedResource()
+                defer { if accessing { url.stopAccessingSecurityScopedResource() } }
+                guard url.pathExtension.lowercased() == "exe", let path = DarkestPort.relativeGamePath(url) else {
+                    throw DarkestPort.Failure("请先把完整游戏复制到 DarkestDungeon/game，再在该目录中选择 .exe。")
+                }
+                selected = path
+                scan()
+            } catch { library.error = error.localizedDescription }
+        }
+        .alert("需要启用 JIT", isPresented: $showJIT) {
+            Button("打开 JIT 设置", action: enableJIT)
+            Button("返回", role: .cancel) {}
+        } message: {
+            Text("使用 Madeira 的 JIT 流程或设备已配置的 StikDebug，确认 JIT 就绪后再开始游戏。")
+        }
+        .alert("需要 Memory+", isPresented: $showMemory) {
+            Button("继续尝试启动") { if let executable { play(executable, arguments) } }
+            Button("返回", role: .cancel) {}
+        } message: {
+            Text("当前签名未授予 Increased Memory Limit，游戏可能因内存不足退出。可以用支持该权限的侧载工具覆盖签名安装。")
+        }
+    }
+}
