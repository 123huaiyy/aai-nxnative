+++ b/app/Madeira/DarkestHUD.swift
@@ -0,0 +1,339 @@
+import Combine
+import SwiftUI
+import UIKit
+
+enum DarkestKey: String, CaseIterable {
+    case left, right, door, shift, torch, map, pause
+
+    var label: String {
+        switch self {
+        case .left: return "A"
+        case .right: return "D"
+        case .door: return "W"
+        case .shift: return "Shift"
+        case .torch: return "T"
+        case .map: return "Tab"
+        case .pause: return "Esc"
+        }
+    }
+
+    var vk: Int32 {
+        switch self {
+        case .left: return 0x41
+        case .right: return 0x44
+        case .door: return 0x57
+        case .shift: return 0x10
+        case .torch: return 0x54
+        case .map: return 0x09
+        case .pause: return 0x1b
+        }
+    }
+}
+
+struct DarkestKeyPlacement: Codable {
+    var x: Double
+    var y: Double
+    var size = 1.0
+    var opacity = 1.0
+    var enabled = true
+}
+
+struct DarkestHUDConfig: Codable {
+    var direct = true
+    var autoHide = false
+    var monitor = false
+    var size = 1.0
+    var opacity = 0.76
+    var longPress = 0.50
+    var keys = [
+        "left": DarkestKeyPlacement(x: 0.09, y: 0.83),
+        "right": DarkestKeyPlacement(x: 0.22, y: 0.83),
+        "door": DarkestKeyPlacement(x: 0.155, y: 0.66),
+        "shift": DarkestKeyPlacement(x: 0.78, y: 0.84),
+        "torch": DarkestKeyPlacement(x: 0.91, y: 0.84),
+        "map": DarkestKeyPlacement(x: 0.91, y: 0.65),
+        "pause": DarkestKeyPlacement(x: 0.91, y: 0.22),
+    ]
+}
+
+final class DarkestHUDModel: ObservableObject {
+    static let shared = DarkestHUDModel()
+    @Published var config: DarkestHUDConfig
+    @Published var settings = false
+    @Published var editing = false
+    @Published var gearVisible = true
+    @Published private(set) var held: Set<DarkestKey> = []
+    private var gearTimer: DispatchWorkItem?
+
+    private var configURL: URL { DarkestPort.root.appendingPathComponent("hud_config.json") }
+
+    private init() {
+        let url = DarkestPort.root.appendingPathComponent("hud_config.json")
+        let data = try? Data(contentsOf: url)
+        config = data.flatMap { try? JSONDecoder().decode(DarkestHUDConfig.self, from: $0) } ?? DarkestHUDConfig()
+    }
+
+    func save() {
+        do {
+            try DarkestPort.makeFolders()
+            try JSONEncoder().encode(config).write(to: configURL, options: .atomic)
+        } catch { LogStore.shared.log("[dd-hud] \(error.localizedDescription)", level: .error) }
+    }
+
+    func placement(_ key: DarkestKey) -> DarkestKeyPlacement {
+        config.keys[key.rawValue] ?? DarkestHUDConfig().keys[key.rawValue]!
+    }
+
+    func assign(_ key: DarkestKey, _ value: DarkestKeyPlacement) {
+        config.keys[key.rawValue] = value
+    }
+
+    func keyRect(_ key: DarkestKey, in bounds: CGRect) -> CGRect {
+        let p = placement(key)
+        let size = CGFloat(50 * min(1.5, max(0.65, config.size)) * min(1.5, max(0.65, p.size)))
+        let x = min(bounds.maxX - size / 2, max(bounds.minX + size / 2, bounds.minX + CGFloat(p.x) * bounds.width))
+        let y = min(bounds.maxY - size / 2, max(bounds.minY + size / 2, bounds.minY + CGFloat(p.y) * bounds.height))
+        return CGRect(x: x - size / 2, y: y - size / 2, width: size, height: size)
+    }
+
+    func gearRect(in bounds: CGRect) -> CGRect {
+        CGRect(x: bounds.maxX - 54, y: bounds.midY - 22, width: 44, height: 44)
+    }
+
+    func modeRect(in bounds: CGRect) -> CGRect {
+        CGRect(x: bounds.midX - 68, y: bounds.minY + 13, width: 136, height: 40)
+    }
+
+    func hits(_ p: CGPoint, in bounds: CGRect) -> Bool {
+        if settings || editing { return true }
+        if (!config.autoHide || gearVisible) && gearRect(in: bounds).contains(p) { return true }
+        if modeRect(in: bounds).contains(p) { return true }
+        return DarkestKey.allCases.contains { placement($0).enabled && keyRect($0, in: bounds).contains(p) }
+    }
+
+    func gameplayTap() {
+        guard config.autoHide, !settings, !editing else { return }
+        gearTimer?.cancel()
+        gearVisible = true
+        let expire = DispatchWorkItem { [weak self] in
+            guard let self, !self.editing, !self.settings else { return }
+            self.gearVisible = false
+        }
+        gearTimer = expire
+        DispatchQueue.main.asyncAfter(deadline: .now() + 3, execute: expire)
+    }
+
+    func press(_ key: DarkestKey) {
+        guard !editing, !settings, placement(key).enabled else { return }
+        UIImpactFeedbackGenerator(style: .light).impactOccurred()
+        if key == .shift, held.contains(key) { release(key); return }
+        guard held.insert(key).inserted else { return }
+        winios_post_key(key.vk, 1)
+    }
+
+    func release(_ key: DarkestKey) {
+        guard held.remove(key) != nil else { return }
+        winios_post_key(key.vk, 0)
+    }
+
+    func releaseAll() {
+        for key in held { winios_post_key(key.vk, 0) }
+        held.removeAll()
+    }
+
+    func reset() {
+        releaseAll()
+        config = DarkestHUDConfig()
+        save()
+    }
+}
+
+/// A touch belongs to this single button until release or cancellation.
+/// UIKit can concurrently route other fingers to the game view below.
+private struct DarkestKeySurface: UIViewRepresentable {
+    let key: DarkestKey
+    let model: DarkestHUDModel
+
+    final class Surface: UIView {
+        var key: DarkestKey = .left
+        weak var model: DarkestHUDModel?
+        private var down = false
+
+        override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent?) {
+            guard !down else { return }
+            down = true
+            model?.press(key)
+        }
+        private func end() {
+            guard down else { return }
+            down = false
+            if key != .shift { model?.release(key) }
+        }
+        override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent?) { end() }
+        override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent?) { end() }
+        override func didMoveToWindow() { if window == nil { end() } }
+    }
+    func makeUIView(context: Context) -> Surface {
+        let view = Surface()
+        view.key = key
+        view.model = model
+        view.isMultipleTouchEnabled = false
+        view.isAccessibilityElement = true
+        view.accessibilityLabel = key.label
+        view.accessibilityTraits = .button
+        return view
+    }
+    func updateUIView(_ uiView: Surface, context: Context) {}
+}
+
+struct DarkestHUD: View {
+    @ObservedObject private var hud = DarkestHUDModel.shared
+    @ObservedObject private var library = LibraryModel.shared
+    @State private var selected = DarkestKey.left
+    private let iron = Color(red: 0.16, green: 0.13, blue: 0.12)
+    private let parchment = Color(red: 0.86, green: 0.76, blue: 0.56)
+
+    var body: some View {
+        GeometryReader { geo in
+            let bounds = CGRect(origin: .zero, size: geo.size)
+            ZStack {
+                ForEach(DarkestKey.allCases, id: \.self) { key in
+                    if hud.placement(key).enabled || hud.editing { control(key, bounds: bounds) }
+                }
+                if !hud.editing {
+                    Button(hud.config.direct ? "直触模式" : "精准虚拟光标") {
+                        MetalBackedView.resetDarkestTouchMode()
+                        hud.config.direct.toggle()
+                        hud.save()
+                        hud.gameplayTap()
+                    }
+                    .buttonStyle(.plain)
+                    .frame(width: 136, height: 40)
+                    .background(iron.opacity(0.85), in: Capsule())
+                    .position(x: hud.modeRect(in: bounds).midX, y: hud.modeRect(in: bounds).midY)
+
+                    if !hud.config.autoHide || hud.gearVisible {
+                        Button {
+                            hud.releaseAll()
+                            hud.settings = true
+                        } label: {
+                            Image(systemName: "gearshape.fill").frame(width: 44, height: 44)
+                        }
+                        .accessibilityLabel("触控设置")
+                        .buttonStyle(.plain)
+                        .background(iron, in: RoundedRectangle(cornerRadius: 7))
+                        .position(x: hud.gearRect(in: bounds).midX, y: hud.gearRect(in: bounds).midY)
+                    }
+                } else {
+                    Button("保存布局") { hud.editing = false; hud.save(); hud.settings = true }
+                        .buttonStyle(.borderedProminent)
+                        .position(x: bounds.midX, y: 34)
+                }
+                if hud.config.monitor && !hud.settings && !hud.editing {
+                    DarkestMeter().position(x: bounds.midX, y: 74).allowsHitTesting(false)
+                }
+                if hud.settings {
+                    settings.frame(width: min(bounds.width - 28, 365), height: min(bounds.height - 30, 520))
+                        .background(iron, in: RoundedRectangle(cornerRadius: 10))
+                }
+            }
+            .foregroundStyle(parchment)
+            .coordinateSpace(name: "darkest-hud")
+        }
+        .ignoresSafeArea()
+        .onAppear { hud.gameplayTap() }
+        .onDisappear { hud.releaseAll(); hud.settings = false; hud.editing = false }
+        .onReceive(NotificationCenter.default.publisher(for: UIApplication.willResignActiveNotification)) { _ in
+            hud.releaseAll()
+        }
+    }
+
+    private func control(_ key: DarkestKey, bounds: CGRect) -> some View {
+        let frame = hud.keyRect(key, in: bounds)
+        let selected = hud.held.contains(key)
+        return ZStack {
+            RoundedRectangle(cornerRadius: 8).fill(selected ? .red.opacity(0.85) : iron)
+            RoundedRectangle(cornerRadius: 8).strokeBorder(parchment.opacity(0.54), lineWidth: 1)
+            Text(key.label).font(.system(.body, design: .serif).weight(.bold))
+            if !hud.editing { DarkestKeySurface(key: key, model: hud) }
+        }
+        .frame(width: frame.width, height: frame.height)
+        .opacity(hud.editing ? 0.95 : max(0.15, min(1, hud.config.opacity * hud.placement(key).opacity)))
+        .position(x: frame.midX, y: frame.midY)
+        .gesture(DragGesture(minimumDistance: 0, coordinateSpace: .named("darkest-hud"))
+            .onChanged { value in
+                var p = hud.placement(key)
+                p.x = max(0, min(1, Double(value.location.x / bounds.width)))
+                p.y = max(0, min(1, Double(value.location.y / bounds.height)))
+                hud.assign(key, p)
+            }, including: hud.editing ? .all : .none)
+    }
+
+    private func binding<T>(_ path: WritableKeyPath<DarkestHUDConfig, T>) -> Binding<T> {
+        Binding(get: { hud.config[keyPath: path] }, set: { value in
+            hud.config[keyPath: path] = value
+            hud.save()
+        })
+    }
+
+    private func keyBinding<T>(_ path: WritableKeyPath<DarkestKeyPlacement, T>) -> Binding<T> {
+        Binding(get: { hud.placement(selected)[keyPath: path] }, set: { value in
+            var p = hud.placement(selected)
+            p[keyPath: path] = value
+            hud.assign(selected, p)
+            hud.save()
+        })
+    }
+
+    private var settings: some View {
+        Form {
+            Button("返回游戏") { hud.settings = false; hud.gameplayTap() }
+            Button("拖动按键") { hud.settings = false; hud.editing = true }
+            Toggle("设置键自动隐藏", isOn: binding(\.autoHide))
+            Toggle("显示 FPS / 内存 / CPU", isOn: binding(\.monitor))
+            VStack { Text("长按右键时间"); Slider(value: binding(\.longPress), in: 0.25...1.2, step: 0.05) }
+            VStack { Text("整体大小"); Slider(value: binding(\.size), in: 0.65...1.5) }
+            VStack { Text("整体透明度"); Slider(value: binding(\.opacity), in: 0.15...1.0) }
+            Picker("编辑按键", selection: $selected) {
+                ForEach(DarkestKey.allCases, id: \.self) { Text($0.label).tag($0) }
+            }
+            Toggle("启用按键", isOn: keyBinding(\.enabled))
+            VStack { Text("按键大小"); Slider(value: keyBinding(\.size), in: 0.65...1.5) }
+            VStack { Text("按键透明度"); Slider(value: keyBinding(\.opacity), in: 0.15...1.0) }
+            Button("恢复默认布局") { hud.reset() }
+            Button("会话菜单") { hud.settings = false; library.menu = true }
+        }
+        .scrollContentBackground(.hidden)
+        .environment(\.colorScheme, .dark)
+    }
+}
+
+private struct DarkestMeter: View {
+    @State private var previousFrames = madeira_frame_count()
+    @State private var previousTime = ProcessInfo.processInfo.systemUptime
+    @State private var text = "FPS —   内存 —   CPU —"
+    @State private var cpu = CPUMeter()
+    private let timer = Timer.publish(every: 0.5, on: .main, in: .common).autoconnect()
+
+    var body: some View {
+        Text(text).monospacedDigit().font(.caption)
+            .padding(6).background(.black.opacity(0.75), in: Capsule())
+            .onReceive(timer) { _ in
+                let frames = madeira_frame_count()
+                let time = ProcessInfo.processInfo.systemUptime
+                let rate = frames >= previousFrames ? Double(frames - previousFrames) / max(0.001, time - previousTime) : 0
+                previousFrames = frames
+                previousTime = time
+                var info = task_vm_info_data_t()
+                var count = mach_msg_type_number_t(MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<integer_t>.size)
+                let status = withUnsafeMutablePointer(to: &info) { ptr in
+                    ptr.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+                        task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+                    }
+                }
+                let memory = status == KERN_SUCCESS ? "\(info.phys_footprint / (1024 * 1024)) MB" : "—"
+                let usage = cpu.sample().map { String(format: "%.0f%%", $0.total) } ?? "—"
+                text = String(format: "%.0f FPS", rate) + "   内存 " + memory + "   CPU " + usage
+            }
+    }
+}
