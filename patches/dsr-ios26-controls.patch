+static const char *const k_b64[DM_ART_N] = {
+    k_attack, // DM_ART_ATTACK
+    k_guard, // DM_ART_GUARD
+    k_dodge, // DM_ART_DODGE
+    k_interact, // DM_ART_INTERACT
+    k_item, // DM_ART_ITEM
+    k_left_weapon, // DM_ART_LEFT_WEAPON
+    k_twohand, // DM_ART_TWOHAND
+    k_lock, // DM_ART_LOCK
+    k_estus, // DM_ART_ESTUS
+    k_spell, // DM_ART_SPELL
+    k_weapon, // DM_ART_WEAPON
+    k_tool, // DM_ART_TOOL
+    k_pause, // DM_ART_PAUSE
+    k_gesture, // DM_ART_GESTURE
+};
+CGImageRef dm_pad_art(int which) {
+    static CGImageRef art[DM_ART_N];
+    static dispatch_once_t once;
+    if (which < 0 || which >= DM_ART_N) return NULL;
+    dispatch_once(&once, ^{
+        for (int i = 0; i < DM_ART_N; i++) {
+            NSString *base64 = [NSString stringWithUTF8String:k_b64[i]];
+            NSData *png = [[NSData alloc] initWithBase64EncodedString:base64 options:0];
+            if (!png) continue;
+            CGImageSourceRef src = CGImageSourceCreateWithData((__bridge CFDataRef)png, NULL);
+            if (!src) continue;
+            art[i] = CGImageSourceCreateImageAtIndex(src, 0, NULL);
+            CFRelease(src);
+        }
+    });
+    return art[which];
+}
