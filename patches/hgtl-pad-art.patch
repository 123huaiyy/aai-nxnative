+CGImageRef dm_pad_art(int which) {
+    static CGImageRef art[DM_ART_N];
+    static dispatch_once_t once;
+    if (which < 0 || which >= DM_ART_N) return NULL;
+    dispatch_once(&once, ^{
+        for (int i = 0; i < DM_ART_N; i++) {
+            const char *b64 = k_b64[i];
+            if (!b64) continue;
+            NSData *png = [[NSData alloc] initWithBase64EncodedString:@(b64) options:0];
+            if (!png) continue;
+            CGImageSourceRef src = CGImageSourceCreateWithData((__bridge CFDataRef)png, NULL);
+            if (!src) continue;
+            CGImageRef img = CGImageSourceCreateImageAtIndex(src, 0, NULL);
+            CFRelease(src);
+            art[i] = img;   // kept for the life of the process: CALayer.contents holds it
+        }
+    });
+    return art[which];
+}
