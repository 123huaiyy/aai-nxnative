diff --git a/dm/ios/Sources/DmPadArt.h b/dm/ios/Sources/DmPadArt.h
new file mode 100644
index 0000000..0e429fa
--- /dev/null
+++ b/dm/ios/Sources/DmPadArt.h
@@ -0,0 +1,38 @@
+// DmPadArt.h: the Game style layout's key glyphs (DmGamepad.m), as the artwork ComfyUI drew for them.
+//   Generated by work/pad_tex/emit_art.py: rerun it instead of editing this file or the table below.
+#ifndef DM_PAD_ART_H
+#define DM_PAD_ART_H
+
+#include <CoreGraphics/CoreGraphics.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    DM_ART_CAST = 0,   // the seal in the bottom-right corner: Basic Cast
+    DM_ART_WARD = 1,   // the shield inward of it: Protego
+    DM_ART_DODGE = 2,   // A: dodge roll
+    DM_ART_ANCIENT = 3,   // X: Ancient Magic
+    DM_ART_INTERACT = 4,   // Y: interact
+    DM_ART_JUMP = 5,   // B: jump
+    DM_ART_SETWHEEL = 6,   // L: the spell set wheel
+    DM_ART_CYCLE = 7,   // R: the next spell set
+    DM_ART_PAUSE = 8,   // plus: the pause menu
+    DM_ART_MAP = 9,   // minus: the field guide
+    DM_ART_VIAL_HEAL = 10,   // potion wheel up: healing
+    DM_ART_VIAL_FOCUS = 11,   // potion wheel left: focus
+    DM_ART_VIAL_POWER = 12,   // potion wheel down: power
+    DM_ART_VIAL_GUARD = 13,   // potion wheel right: guard,
+    DM_ART_N
+};
+
+// The glyph for one key: a 320 px PNG decoded once, kept for the life of the process (a CALayer wants a
+// CGImage that outlives the transaction). NULL only if the table itself is malformed, which the unit test
+// checks; the pad then draws its keys without art rather than failing to start.
+CGImageRef dm_pad_art(int which);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
