+static CGFloat clamp(CGFloat value, CGFloat low, CGFloat high) {
+    return MIN(MAX(value, low), high);
+}
+static NSString *placementKey(int control) {
+    return [NSString stringWithFormat:@"%d", control];
+}
+
+- (CGFloat)styleOpacity:(int)control {
+    NSNumber *value = _style ? _customPad[placementKey(control)][@"opacity"] : nil;
+    return [value isKindOfClass:NSNumber.class] && isfinite(value.doubleValue)
+        ? clamp(value.doubleValue, 0.2, 1) : 1;
+}
+
+- (CGFloat)styleScale:(int)control {
+    NSNumber *scale = _style ? _customPad[placementKey(control)][@"scale"] : nil;
+    return [scale isKindOfClass:NSNumber.class] && isfinite(scale.doubleValue)
+        ? clamp(scale.doubleValue, 0.65, 1.6) : 1;
+}
+
+- (CGPoint)styleCenter:(int)control fallback:(CGPoint)fallback radius:(CGFloat)radius {
+    NSDictionary *placement = _style ? _customPad[placementKey(control)] : nil;
+    CGRect safe = self.safe;
+    if (!placement || CGRectIsEmpty(safe)) return fallback;
+    NSNumber *x = placement[@"x"], *y = placement[@"y"];
+    CGPoint center = fallback;
+    if ([x isKindOfClass:NSNumber.class] && [y isKindOfClass:NSNumber.class] &&
+        isfinite(x.doubleValue) && isfinite(y.doubleValue)) {
+        center = CGPointMake(CGRectGetMinX(safe) + clamp(x.doubleValue, 0, 1) * safe.size.width,
+                             CGRectGetMinY(safe) + clamp(y.doubleValue, 0, 1) * safe.size.height);
+    }
+    // The full glyph and caption stay inside the safe area after a rotation or resize.
+    CGFloat margin = radius * [self styleScale:control] * self.u;
+    CGFloat dx = MIN(margin, safe.size.width / 2), dy = MIN(margin, safe.size.height / 2);
+    return CGPointMake(clamp(center.x, CGRectGetMinX(safe) + dx, CGRectGetMaxX(safe) - dx),
+                       clamp(center.y, CGRectGetMinY(safe) + dy, CGRectGetMaxY(safe) - dy));
+}
