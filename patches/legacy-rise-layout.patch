+
+    _editorSmaller = [self editorButton:@"\u7f29\u5c0f" action:@selector(editorShrink)];
+    _editorLarger = [self editorButton:@"\u653e\u5927" action:@selector(editorGrow)];
+    _editorFainter = [self editorButton:@"减淡" action:@selector(editorFade)];
+    _editorBrighter = [self editorButton:@"增亮" action:@selector(editorBrighten)];
