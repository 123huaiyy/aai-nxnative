+int dm_rise_cheats_set_zenny(void) {
+    pthread_mutex_lock(&g_lock);
+    uint64_t save, purse;
+    where_t region;
+    const uint32_t zenny = 9999999;
+    int result = -1;
+    if (atomic_load(&g_rise_switches) && atomic_load(&g_master) &&
+        !peek((uint64_t)(uintptr_t)g_main_mod->base + 0x12b157c0, 8, &save) && save &&
+        save <= UINT64_MAX - 0x58 && !where_get(save + 0x58, 8, &region) && region.kind == WH_HEAP &&
+        !peek(save + 0x58, 8, &purse) && purse && purse <= UINT64_MAX - 0x18 &&
+        !where_get(purse + 0x18, sizeof zenny, &region) && region.kind == WH_HEAP)
+        result = dm_guest_heap_write(purse + 0x18, &zenny, sizeof zenny);
+    pthread_mutex_unlock(&g_lock);
+    return result;
+}
