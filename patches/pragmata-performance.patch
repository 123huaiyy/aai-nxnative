+// The same pixels in both layouts must produce identical movie output, including
+// cropped, padded, and odd-sized requests and a pair of independent destination planes.
+static void nv12_output_layout(void) {
+    enum { W = 64, H = 8 };
+    vpx_image_t *planar = vpx_img_alloc(NULL, VPX_IMG_FMT_I420, W, H, 16);
+    vpx_image_t *packed = vpx_img_alloc(NULL, VPX_IMG_FMT_NV12, W, H, 16);
+    assert(planar && packed);
+    for (int row = 0; row < H; row++) for (int x = 0; x < W; x++) {
+        uint8_t y = (uint8_t)(16 + row * 3 + x);
+        planar->planes[0][(size_t)row * planar->stride[0] + x] = y;
+        packed->planes[0][(size_t)row * packed->stride[0] + x] = y;
+    }
+    for (int row = 0; row < H / 2; row++) for (int x = 0; x < W / 2; x++) {
+        uint8_t u = (uint8_t)(60 + row + x), v = (uint8_t)(160 - 2 * x - row);
+        planar->planes[1][(size_t)row * planar->stride[1] + x] = u;
+        planar->planes[2][(size_t)row * planar->stride[2] + x] = v;
+        packed->planes[1][(size_t)row * packed->stride[1] + 2 * x] = u;
+        packed->planes[2][(size_t)row * packed->stride[2] + 2 * x] = v;
+    }
+    const int sizes[][2] = {{W, H}, {W - 1, H - 1}, {W + 2, H + 2}};
+    for (unsigned i = 0; i < sizeof sizes / sizeof *sizes; i++) {
+        const int w = sizes[i][0], h = sizes[i][1];
+        const size_t ysize = (size_t)w * h, uvsize = ysize / 2;
+        uint8_t a[(W + 2) * (H + 2) * 4], b[sizeof a];
+        uint8_t y[(W + 2) * (H + 2)], uv[sizeof y / 2];
+        md_nv12(planar, a, w, h);
+        md_nv12_planes(packed, y, uv, w, h);
+        assert(!memcmp(a, y, ysize) && !memcmp(a + ysize, uv, uvsize));
+        md_rgba(planar, a, w, h); md_rgba(packed, b, w, h);
+        assert(!memcmp(a, b, ysize * 4));
+    }
+    vpx_img_free(planar); vpx_img_free(packed);
+}
 int main(void) {
+    nv12_output_layout();
+    puts("AVC native NV12: same NV12 and RGBA pixels in tight and split buffers, with crop and pad");
