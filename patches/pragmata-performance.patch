+++ b/dm/gfx/nvn/pragmata_ui_viewport.h
@@ -0,0 +1,19 @@
+// PRAGMATA v196608 screen interface targets, identified from the NVN render pass recordings.
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+static inline bool pragmata_ui_target(const char *vertex, uint64_t width, uint64_t height, bool ui_format) {
+    if (!vertex || !ui_format || !height || width * 9 != height * 16) return false;
+    return strcmp(vertex, "d84fd24ea0cd67c4_b") == 0   // screen images and text
+        || strcmp(vertex, "0f635c1667f616df_b") == 0   // companion variant of the same program
+        || strcmp(vertex, "9299e20c8df468c3_b") == 0   // interface render group
+        || strcmp(vertex, "9726482004323ffe_b") == 0;  // interface render group with an auxiliary target
+}
+
+#define PRAGMATA_UI_WIDTH_SCALE (16.0 / 21.0)
+
+static inline double pragmata_ui_x(double x, double target_width) {
+    return x * PRAGMATA_UI_WIDTH_SCALE + target_width * (1.0 - PRAGMATA_UI_WIDTH_SCALE) * 0.5;
+}
