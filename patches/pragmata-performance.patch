diff --git a/dm/gfx/msl/present.metal b/dm/gfx/msl/present.metal
index 5bfdfea..b84f84b 100644
--- a/dm/gfx/msl/present.metal
+++ b/dm/gfx/msl/present.metal
@@ -5,3 +5,36 @@ struct V { float4 p [[position]]; float2 uv; };
 vertex V vs(uint id [[vertex_id]]) { float2 uv = float2((id << 1) & 2, id & 2); V o; o.p = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1); o.uv = uv; return o; }
 struct Crop { float4 rect; float4 edge; };
 fragment float4 fs(V in [[stage_in]], texture2d<float> t [[texture(0)]], sampler s [[sampler(0)]], constant Crop& c [[buffer(0)]]) { return t.sample(s, clamp(in.uv * c.rect.zw + c.rect.xy, c.edge.xy, c.edge.zw)); }
+
+// PRAGMATA's legacy cutscene boundaries can leave an almost black texel between
+// two continuous parts of the picture. Test only narrow strips at those boundaries.
+struct WideCrop { float4 rect; float4 edge; float4 seams; };
+static float seam_luma(float3 c) { return dot(c, float3(0.2126f, 0.7152f, 0.0722f)); }
+
+fragment float4 fs_pragmata_seams(V in [[stage_in]], texture2d<float> t [[texture(0)]],
+                                 sampler s [[sampler(0)]], constant WideCrop& c [[buffer(0)]]) {
+    float2 uv = clamp(in.uv * c.rect.zw + c.rect.xy, c.edge.xy, c.edge.zw);
+    float4 pixel = t.sample(s, uv);
+    float x = min(in.uv.x, 1.0f - in.uv.x);
+    float distance = abs(x - c.seams.x);
+    if (c.seams.y > 0.015f && c.seams.y < 0.22f)
+        distance = min(distance, abs(x - c.seams.y));
+    float step = 1.0f / float(t.get_width());
+    if (distance * c.rect.z > 3.0f * step) return pixel;
+
+    float2 dx = float2(3.25f * step, 0.0f);
+    float3 left = t.sample(s, clamp(uv - dx, c.edge.xy, c.edge.zw)).rgb;
+    float3 right = t.sample(s, clamp(uv + dx, c.edge.xy, c.edge.zw)).rgb;
+    float ls = seam_luma(left), rs = seam_luma(right);
+    float level = min(ls, rs);
+    if (level <= 0.032f || abs(ls - rs) > max(0.045f, 0.7f * level)) return pixel;
+
+    float value = seam_luma(pixel.rgb);
+    if (value >= 0.76f * level) return pixel;
+    float2 dy = float2(0.0f, 5.0f / float(t.get_height()));
+    float above = seam_luma(t.sample(s, clamp(uv - dy, c.edge.xy, c.edge.zw)).rgb);
+    float below = seam_luma(t.sample(s, clamp(uv + dy, c.edge.xy, c.edge.zw)).rgb);
+    if (min(above, below) > 0.9f * level) return pixel;
+
+    return float4((left + right) * 0.5f, pixel.a);
+}
