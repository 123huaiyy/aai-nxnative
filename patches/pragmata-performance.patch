+import Foundation
+
+enum LauncherLanguage: String, CaseIterable, Identifiable {
+    case system, en, zhHans = "zh-Hans", zhHant = "zh-Hant", ja, ko, fr, de, es
+
+    var id: String { rawValue }
+    var menuName: String {
+        switch self {
+        case .system: return "System language"
+        case .en: return "English"
+        case .zhHans: return "简体中文"
+        case .zhHant: return "繁體中文"
+        case .ja: return "日本語"
+        case .ko: return "한국어"
+        case .fr: return "Français"
+        case .de: return "Deutsch"
+        case .es: return "Español"
+        }
+    }
+    static func resolve(_ identifier: String, preferred: [String] = Locale.preferredLanguages) -> Self {
+        if let chosen = Self(rawValue: identifier), chosen != .system { return chosen }
+        for tag in preferred {
+            let parts = tag.lowercased().replacingOccurrences(of: "_", with: "-").split(separator: "-")
+            guard let base = parts.first else { continue }
+            if base == "zh" { return parts.contains { ["hant", "tw", "hk", "mo"].contains($0) } ? .zhHant : .zhHans }
+            if let language = Self(rawValue: String(base)), language != .system { return language }
+        }
+        return .en
+    }
+    var locale: Locale { Locale(identifier: rawValue) }
+
+    func text(_ key: String) -> String {
+        guard let translations = Self.strings[key] else { return key }
+        switch self {
+        case .en, .system: return key
+        case .zhHans: return translations[0]
+        case .zhHant:
+            return translations[0].applyingTransform(StringTransform("Simplified-Traditional"), reverse: false) ?? translations[0]
+        case .ja: return translations[1]
+        case .ko: return translations[2]
+        case .fr: return translations[3]
+        case .de: return translations[4]
+        case .es: return translations[5]
+        }
+    }
+
+    private static let strings: [String: [String]] = {
+        var table: [String: [String]] = [:]
+        for row in catalog.split(separator: "\n") {
+            let fields = row.split(separator: "|", omittingEmptySubsequences: false).map(String.init)
+            guard fields.count == 7 else { continue }
+            table[fields[0]] = Array(fields.dropFirst())
+        }
+        return table
+    }()
+
+    // Source text, Simplified Chinese, Japanese, Korean, French, German, Spanish.
