diff --git a/dm/ios/Sources/DmOrbitEditor.inc b/dm/ios/Sources/DmOrbitEditor.inc
new file mode 100644
index 0000000..9043c36
--- /dev/null
+++ b/dm/ios/Sources/DmOrbitEditor.inc
@@ -0,0 +1,257 @@
+/* The Orbit layout editor, included in the DmGamepad implementation. */
+
+static const NSInteger k_orbit_editable[] = {
+    B_ZL, B_ZR, B_A, B_B, B_X, B_Y, B_L, B_R, B_MINUS, B_PLUS,
+    B_OD, B_F2, B_ORBIT_STICK, B_ORBIT_DPAD,
+};
+
+static CGFloat orbitEditorClamp(CGFloat value, CGFloat low, CGFloat high) {
+    return fmin(fmax(value, low), high);
+}
+
+static NSURL *orbitLayoutURL(void) {
+    NSURL *docs = [NSFileManager.defaultManager URLsForDirectory:NSDocumentDirectory inDomains:NSUserDomainMask].firstObject;
+    return [docs URLByAppendingPathComponent:@"touch-layout-v1.json"];
+}
+
+- (void)loadOrbitLayout {
+    _orbitPlacement = [NSMutableDictionary dictionary];
+    NSData *data = [NSData dataWithContentsOfURL:orbitLayoutURL()];
+    id payload = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+    if (![payload isKindOfClass:NSDictionary.class] || ![payload[@"version"] isEqual:@1]) return;
+    id controls = payload[@"controls"];
+    if (![controls isKindOfClass:NSDictionary.class]) return;
+    for (NSUInteger i = 0; i < sizeof(k_orbit_editable) / sizeof(k_orbit_editable[0]); i++) {
+        NSString *key = orbitPlacementKey(k_orbit_editable[i]);
+        id row = controls[key];
+        if (![row isKindOfClass:NSDictionary.class]) continue;
+        NSMutableDictionary *entry = [NSMutableDictionary dictionary];
+        for (NSString *field in @[@"x", @"y", @"scale", @"opacity"]) {
+            id value = row[field];
+            if (![value isKindOfClass:NSNumber.class] || !isfinite([value doubleValue])) continue;
+            CGFloat low = [field isEqual:@"scale"] ? 0.65 : [field isEqual:@"opacity"] ? 0.2 : 0;
+            CGFloat high = [field isEqual:@"scale"] ? 1.6 : 1;
+            entry[field] = @(orbitEditorClamp([value doubleValue], low, high));
+        }
+        if (entry.count) _orbitPlacement[key] = entry;
+    }
+}
+
+- (BOOL)canEditOrbit { return self.orbit && !_padOff; }
+
+- (CGFloat)orbitOpacity:(NSInteger)key {
+    NSNumber *opacity = self.orbit ? [self orbitPlacement:key][@"opacity"] : nil;
+    return opacity ? opacity.doubleValue : 1;
+}
+
+- (void)applyOrbitOpacity {
+    for (int key = 0; key <= B_F2; key++) {
+        BOOL directional = key >= B_LEFT && key <= B_DOWN;
+        CGFloat opacity = [self orbitOpacity:directional ? B_ORBIT_DPAD : key];
+        CAShapeLayer *shape = key == B_OD ? _od : key == B_F2 ? _fire2 : _key[key];
+        shape.opacity = opacity;
+    }
+    _lockHint.opacity = [self orbitOpacity:B_ZL];
+    _ring.opacity = _knob.opacity = [self orbitOpacity:B_ORBIT_STICK];
+}
+
+- (CGPoint)orbitEditorCentre:(NSInteger)key {
+    if (key == B_ORBIT_STICK) return self.stickHome;
+    if (key == B_ORBIT_DPAD) return self.dpadCenter;
+    return [self keyCentre:(int)key];
+}
+
+- (CGFloat)orbitEditorRadius:(NSInteger)key {
+    if (key == B_ORBIT_STICK) return [self stickR:0];
+    if (key == B_ORBIT_DPAD) return self.dpadR;
+    return [self keyRadius:(int)key];
+}
+
+- (NSInteger)orbitEditorKeyAt:(CGPoint)point {
+    NSInteger best = -1;
+    CGFloat nearest = 1;
+    for (NSUInteger i = 0; i < sizeof(k_orbit_editable) / sizeof(k_orbit_editable[0]); i++) {
+        NSInteger key = k_orbit_editable[i];
+        if (!_full && (key == B_ORBIT_DPAD || key == B_L)) continue;
+        CGFloat distance = dist(point, [self orbitEditorCentre:key]) / MAX([self orbitEditorRadius:key] + 10, 22);
+        if (distance < nearest) { best = key; nearest = distance; }
+    }
+    return best;
+}
+
+- (NSString *)orbitEditorTitle:(NSInteger)key {
+    switch (key) {
+        case B_ORBIT_STICK: return @"移动摇杆";
+        case B_ORBIT_DPAD: return @"方向键";
+        case B_OD: return @"超载 LS+RS";
+        case B_F2: return @"副射击 ZR";
+        default: return [_label[key].string isKindOfClass:NSString.class] ? _label[key].string : @"按键";
+    }
+}
+
+- (void)layoutOrbitEditor {
+    if (!_orbitEditor) return;
+    _orbitEditor.frame = self.bounds;
+    _orbitCanvas.frame = _orbitEditor.bounds;
+    _orbitSelection.frame = _orbitCanvas.bounds;
+    CGRect safe = self.safe;
+    CGFloat w = MIN(CGRectGetWidth(safe) - 16, 520);
+    _orbitPanel.frame = CGRectMake(CGRectGetMidX(safe) - w / 2, CGRectGetMinY(safe) + 4, w, 70);
+    _orbitSelection.hidden = _orbitSelected < 0;
+    if (_orbitSelected >= 0) {
+        CGPoint centre = [self orbitEditorCentre:_orbitSelected];
+        setPath(_orbitSelection, circlePath(centre, [self orbitEditorRadius:_orbitSelected] + 5));
+    }
+}
+
+- (void)selectOrbitEditorKey:(NSInteger)key {
+    _orbitSelected = key;
+    _orbitSelectedName.text = key >= 0 ? [self orbitEditorTitle:key] : @"点选或拖动按键";
+    _orbitSize.enabled = _orbitOpacity.enabled = key >= 0;
+    _orbitSize.value = key >= 0 ? [self orbitScale:key] : 1;
+    _orbitOpacity.value = key >= 0 ? [self orbitOpacity:key] : 1;
+    [self layoutOrbitEditor];
+}
+
+- (void)orbitEditorPoint:(CGPoint)point {
+    CGRect area = self.safe;
+    if (_orbitSelected < 0 || CGRectIsEmpty(area)) return;
+    CGFloat radius = [self orbitEditorRadius:_orbitSelected];
+    CGFloat xMargin = MIN(radius + 4, CGRectGetWidth(area) / 2);
+    CGFloat yMargin = MIN(radius + 4, CGRectGetHeight(area) / 2);
+    CGFloat x = orbitEditorClamp(point.x, CGRectGetMinX(area) + xMargin, CGRectGetMaxX(area) - xMargin);
+    CGFloat y = orbitEditorClamp(point.y, CGRectGetMinY(area) + yMargin, CGRectGetMaxY(area) - yMargin);
+    NSMutableDictionary *entry = [[self orbitPlacement:_orbitSelected] mutableCopy] ?: [NSMutableDictionary dictionary];
+    entry[@"x"] = @((x - CGRectGetMinX(area)) / CGRectGetWidth(area));
+    entry[@"y"] = @((y - CGRectGetMinY(area)) / CGRectGetHeight(area));
+    _orbitPlacement[orbitPlacementKey(_orbitSelected)] = entry;
+    [self setNeedsLayout];
+    [self layoutIfNeeded];
+}
+
+- (void)orbitEditorTap:(UITapGestureRecognizer *)tap {
+    [self selectOrbitEditorKey:[self orbitEditorKeyAt:[tap locationInView:self]]];
+}
+
+- (void)orbitEditorPan:(UIPanGestureRecognizer *)pan {
+    CGPoint delta = [pan translationInView:self];
+    if (pan.state == UIGestureRecognizerStateBegan) {
+        CGPoint current = [pan locationInView:self];
+        CGPoint touch = CGPointMake(current.x - delta.x, current.y - delta.y);
+        [self selectOrbitEditorKey:[self orbitEditorKeyAt:touch]];
+        if (_orbitSelected >= 0) _orbitDragOrigin = [self orbitEditorCentre:_orbitSelected];
+    }
+    if (_orbitSelected >= 0 && (pan.state == UIGestureRecognizerStateChanged || pan.state == UIGestureRecognizerStateEnded))
+        [self orbitEditorPoint:CGPointMake(_orbitDragOrigin.x + delta.x, _orbitDragOrigin.y + delta.y)];
+}
+
+- (void)orbitEditorSlider:(UISlider *)slider {
+    if (_orbitSelected < 0) return;
+    NSMutableDictionary *entry = [[self orbitPlacement:_orbitSelected] mutableCopy] ?: [NSMutableDictionary dictionary];
+    NSString *field = slider == _orbitSize ? @"scale" : @"opacity";
+    entry[field] = @(slider.value);
+    _orbitPlacement[orbitPlacementKey(_orbitSelected)] = entry;
+    if (slider == _orbitSize && entry[@"x"]) [self orbitEditorPoint:[self orbitEditorCentre:_orbitSelected]];
+    else { [self setNeedsLayout]; [self layoutIfNeeded]; }
+}
+
+- (void)endOrbitEditorSaved:(BOOL)save {
+    if (save) {
+        NSDictionary *payload = @{@"version": @1, @"controls": _orbitPlacement};
+        NSError *error = nil;
+        NSData *data = [NSJSONSerialization dataWithJSONObject:payload options:NSJSONWritingSortedKeys error:&error];
+        if (!data || ![data writeToURL:orbitLayoutURL() options:NSDataWritingAtomic error:&error]) {
+            LOG("[RED] could not save Orbit layout: %s", error.localizedDescription.UTF8String ?: "unknown error");
+            _orbitSelectedName.text = @"保存失败";
+            return;
+        }
+    } else {
+        _orbitPlacement = [_orbitBeforeEdit mutableCopy];
+    }
+    _orbitBeforeEdit = nil;
+    [_orbitEditor removeFromSuperview];
+    _orbitEditor = _orbitCanvas = nil;
+    [self updateTouchVisibility];
+    [_transientGear setEditing:NO];
+    _orbitPanel = nil;
+    _orbitSelection = nil;
+    _orbitSelectedName = nil;
+    _orbitSize = _orbitOpacity = nil;
+    [self setNeedsLayout];
+    [self refresh];
+    [self armDim];
+}
+
+- (UIButton *)orbitEditorButton:(NSString *)title handler:(void (^)(void))handler {
+    UIButton *button = [UIButton buttonWithType:UIButtonTypeSystem];
+    [button setTitle:title forState:UIControlStateNormal];
+    button.tintColor = UIColor.whiteColor;
+    [button addAction:[UIAction actionWithHandler:^(__unused UIAction *action) { handler(); }] forControlEvents:UIControlEventTouchUpInside];
+    return button;
+}
+
+- (UILabel *)orbitEditorLabel:(NSString *)text {
+    UILabel *label = [UILabel new];
+    label.text = text;
+    label.textColor = UIColor.whiteColor;
+    label.font = [UIFont systemFontOfSize:12 weight:UIFontWeightSemibold];
+    [label setContentHuggingPriority:UILayoutPriorityRequired forAxis:UILayoutConstraintAxisHorizontal];
+    return label;
+}
+
+- (void)beginOrbitEditor {
+    if (![self canEditOrbit] || _orbitEditor) return;
+    if (!_full) [self setPadLayout:1];
+    [self reset];
+    [self wake];
+    _orbitBeforeEdit = [_orbitPlacement copy];
+    _orbitEditor = [[UIView alloc] initWithFrame:self.bounds];
+    [_transientGear setEditing:YES];
+    [self updateTouchVisibility];
+    _orbitCanvas = [[UIView alloc] initWithFrame:_orbitEditor.bounds];
+    [_orbitEditor addSubview:_orbitCanvas];
+    [_orbitCanvas addGestureRecognizer:[[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(orbitEditorTap:)]];
