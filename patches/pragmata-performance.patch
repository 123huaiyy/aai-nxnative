diff --git a/dm/gfx/nvn/nvn_framegen_budget.h b/dm/gfx/nvn/nvn_framegen_budget.h
new file mode 100644
index 0000000..f2517dc
--- /dev/null
+++ b/dm/gfx/nvn/nvn_framegen_budget.h
@@ -0,0 +1,36 @@
+// Admission policy for optional frame generation. Times and budget are in ms.
+#pragma once
+#include <stdbool.h>
+
+enum { FG_BUDGET_SLOW_FRAMES = 4, FG_BUDGET_RECOVERY_FRAMES = 45 };
+
+typedef struct {
+    unsigned slow, cool;
+    bool paused;
+} nvn_framegen_budget;
+
+// Unavailable samples are negative. Stale GPU feedback signals work in flight
+// only after at least one completed render sample has been seen.
+static inline bool nvn_framegen_budget_step(nvn_framegen_budget *state, double budget_ms,
+                                            double native_gpu_ms, double frame_ms,
+                                            double interpolation_ms, bool gpu_backlogged) {
+    const double cost = native_gpu_ms + interpolation_ms + 2.0;   // room for the snapshot and present
+    if (!state->paused) {
+        bool late = gpu_backlogged || frame_ms > budget_ms * 1.28 ||
+                    (native_gpu_ms >= 0.0 && cost > budget_ms);
+        state->slow = late ? state->slow + 1 : 0;
+        if (state->slow >= FG_BUDGET_SLOW_FRAMES) {
+            state->paused = true;
+            state->slow = 0;
+        }
+    } else {
+        bool has_room = !gpu_backlogged && native_gpu_ms >= 0.0 && frame_ms >= 0.0 &&
+                        frame_ms <= budget_ms * 1.12 && cost <= budget_ms * 0.90;
+        state->cool = has_room ? state->cool + 1 : 0;
+        if (state->cool >= FG_BUDGET_RECOVERY_FRAMES) {
+            state->paused = false;
+            state->cool = 0;
+        }
+    }
+    return state->paused;
+}
