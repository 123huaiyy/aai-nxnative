diff --git a/dm/tools/pragmata_performance.py b/dm/tools/pragmata_performance.py
new file mode 100644
index 0000000..1955c46
--- /dev/null
+++ b/dm/tools/pragmata_performance.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Summarize native frame times and confirmed display times in an NVN TSV."""
+
+import argparse
+import json
+import math
+import statistics
+from pathlib import Path
+
+
+def read_frames(path):
+    frames = {}
+    with path.open(encoding="utf-8-sig") as stream:
+        for line in stream:
+            columns = line.rstrip("\r\n").split("\t")
+            if len(columns) != 3 or not columns[1].startswith("@"):
+                continue
+            try:
+                frame = int(columns[0])
+                value = float(columns[2])
+            except ValueError:
+                continue
+            if math.isfinite(value):
+                frames.setdefault(frame, {})[columns[1]] = value
+    return dict(sorted(frames.items()))
+
+
+def percentile(sorted_values, fraction):
+    index = (len(sorted_values) - 1) * fraction
+    low = math.floor(index)
+    return round(sorted_values[low] + (sorted_values[math.ceil(index)] - sorted_values[low]) * (index - low), 3)
+
+
+def distribution(samples):
+    vals = sorted(samples)
+    if not vals:
+        return {}
+
+    def low_fps(fraction):
+        size = max(1, math.ceil(len(vals) * fraction))
+        return round(1000 / statistics.mean(vals[-size:]), 3)
+
+    return {
+        "samples": len(vals),
+        "mean_ms": round(statistics.mean(vals), 3),
+        "p50_ms": percentile(vals, 0.50),
+        "p95_ms": percentile(vals, 0.95),
+        "p99_ms": percentile(vals, 0.99),
+        "max_ms": vals[-1],
+        "fps": round(1000 * len(vals) / sum(vals), 3),
+        "1_percent_low_fps": low_fps(0.01),
+        "0.1_percent_low_fps": low_fps(0.001),
+    }
+
+
+def effective_rate(samples, counter):
+    known = [row for row in samples if "@sample_s" in row and counter in row]
+    if len(known) < 2:
+        return None
+    span = known[-1]["@sample_s"] - known[0]["@sample_s"]
+    count = known[-1][counter] - known[0][counter]
+    return round(count / span, 3) if span > 0 else None
+
+
+def summarize(frames, target):
+    rows = list(frames.values())
+    matched_times = [row["@frame_ms"] for row in rows if row.get("@frame_ms", 0) > 0]
+    deadline = 1000 / target
+    native = distribution(matched_times)
+    native["over_budget"] = sum(ms > deadline for ms in matched_times)
+    native["over_1.5x_budget"] = sum(ms > deadline * 1.5 for ms in matched_times)
+    timings = {}
+    for name in ("cpu_ms", "proc_cpu_ms", "gpu_ms", "nvn_ms", "sync_ms", "drawable_ms",
+                 "wait_ms", "pq_wait_ms", "sub_wall_ms", "upload_ms", "upload_gpu_ms"):
+        vals = sorted(row["@" + name] for row in rows if row.get("@" + name, -1) >= 0)
+        if vals:
+            timings[name] = {
+                "samples": len(vals),
+                "mean": round(statistics.mean(vals), 3),
+                "p95": percentile(vals, 0.95),
+                "p99": percentile(vals, 0.99),
+                "max": vals[-1],
+            }
+    native_display = effective_rate(rows, "@native_presented_total")
+    generated_display = effective_rate(rows, "@generated_presented_total")
+    samples = {}
+    for name in ("gpu_alloc_mib", "gpu_budget_mib", "residency_set_mib", "footprint_mib",
+                 "kernel_footprint_peak_mib", "thermal_state", "framegen_gpu_ema_ms", "framegen_budget_paused"):
+        vals = [row["@" + name] for row in rows if "@" + name in row]
+        if vals:
+            samples[name] = {"first": vals[0], "last": vals[-1], "max": max(vals)}
+    for name in ("scene", "upscale", "drawable"):
+        dims = {(int(row["@" + name + "_w"]), int(row["@" + name + "_h"])) for row in rows
+                if "@" + name + "_w" in row and "@" + name + "_h" in row}
+        if dims:
+            samples[name + "_sizes"] = sorted(dims)
+    work = {name: sum(row.get("@" + name, 0) for row in rows)
+            for name in ("passes", "draws", "pso_new", "lib_new")
+            if any("@" + name in row for row in rows)}
+    for name in ("metal4_buffers_total", "guest_dispatches_total", "romfs_reads_total", "romfs_read_mib_total",
+                 "romfs_read_wall_ms_total", "shader_cache_hits_total", "shader_cache_misses_total",
+                 "framegen_budget_skipped_total", "indirect_mask_jobs_total", "indirect_mask_threads_total",
+                 "indirect_mask_dispatches_total"):
+        vals = [row["@" + name] for row in rows if "@" + name in row]
+        if len(vals) >= 2:
+            work[name] = round(vals[-1] - vals[0], 3)
+    hits = work.get("shader_cache_hits_total", 0)
+    attempts = hits + work.get("shader_cache_misses_total", 0)
+    if attempts:
+        work["shader_cache_hit_pct"] = round(100 * hits / attempts, 3)
+    return {
+        "target_fps": target,
+        "native_game_frames": native,
+        "confirmed_display": {
+            "native_fps": native_display,
+            "generated_fps": generated_display,
+            "combined_fps": round(native_display + generated_display, 3)
+            if native_display is not None and generated_display is not None else None,
+            "discarded_guest_presents": sum(row.get("@presented_ms", 0) < 0 for row in rows),
+            "guest_ticket_intervals": distribution(
+                row["@presented_ms"] for row in rows if row.get("@presented_ms", 0) > 0),
+        },
+        "timings_ms": timings,
+        "samples": samples,
+        "gpu_and_pipeline_work": work,
+        "longest_frames": [
+            {"frame": f, **{k.removeprefix("@"): v for k, v in row.items() if k in (
+                "@frame_ms", "@gpu_ms", "@nvn_ms", "@wait_ms", "@sync_ms", "@drawable_ms",
+                "@upload_ms", "@pso_new", "@presented_ms", "@sub_wall_ms")}}
+            for f, row in sorted(frames.items(), key=lambda pair: pair[1].get("@frame_ms", 0), reverse=True)[:12]
+            if row.get("@frame_ms", 0) > deadline * 1.5
+        ],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("tsv", type=Path)
+    parser.add_argument("--target", type=int, choices=(30, 60), default=30)
+    parser.add_argument("--first-frame", type=int, default=0)
+    parser.add_argument("--last-frame", type=int)
+    args = parser.parse_args()
+    frames = {f: row for f, row in read_frames(args.tsv).items() if f >= args.first_frame
+              and (args.last_frame is None or f <= args.last_frame)}
+    if not frames:
+        parser.error("no timing samples in the selected frame range")
+    print(json.dumps(summarize(frames, args.target), ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
