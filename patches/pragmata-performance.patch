diff --git a/dm/gfx/tests/t_framegen_budget.c b/dm/gfx/tests/t_framegen_budget.c
new file mode 100644
index 0000000..bedc47f
--- /dev/null
+++ b/dm/gfx/tests/t_framegen_budget.c
@@ -0,0 +1,32 @@
+#include "../nvn/nvn_framegen_budget.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    const double budget = 1000.0 / 30.0;
+    nvn_framegen_budget state = {0};
+    for (int i = 0; i < 6; i++)
+        assert(!nvn_framegen_budget_step(&state, budget, -1, -1, 8, false));
+    for (int i = 0; i < 80; i++)
+        assert(!nvn_framegen_budget_step(&state, budget, 16, 33.4, 7, false));
+    assert(!nvn_framegen_budget_step(&state, budget, 41, 53, 7, false));
+    assert(!nvn_framegen_budget_step(&state, budget, 17, 33.3, 7, false));
+    for (int i = 1; i < FG_BUDGET_SLOW_FRAMES; i++)
+        assert(!nvn_framegen_budget_step(&state, budget, 39, 55, 7, false));
+    assert(nvn_framegen_budget_step(&state, budget, 39, 55, 7, false));
+    for (int i = 0; i < 60; i++) {
+        assert(nvn_framegen_budget_step(&state, budget, -1, 33.3, 7, true));
+        assert(nvn_framegen_budget_step(&state, budget, 25, 33.3, 7, false));
+    }
+    for (int i = 1; i < FG_BUDGET_RECOVERY_FRAMES; i++)
+        assert(nvn_framegen_budget_step(&state, budget, 17, 33.4, 7, false));
+    assert(nvn_framegen_budget_step(&state, budget, 17, 46, 7, false));
+    for (int i = 1; i < FG_BUDGET_RECOVERY_FRAMES; i++)
+        assert(nvn_framegen_budget_step(&state, budget, 17, 33.4, 7, false));
+    assert(!nvn_framegen_budget_step(&state, budget, 17, 33.4, 7, false));
+    for (int i = 1; i < FG_BUDGET_SLOW_FRAMES; i++)
+        assert(!nvn_framegen_budget_step(&state, budget, 17, 33.4, 17, false));
+    assert(nvn_framegen_budget_step(&state, budget, 17, 33.4, 17, false));
+    puts("frame generation budget: startup, transient delay, overload, backlog and recovery passed");
+    return 0;
+}
