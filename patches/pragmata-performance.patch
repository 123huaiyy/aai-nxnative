diff --git a/dm/gfx/nvn/pragmata_memory.h b/dm/gfx/nvn/pragmata_memory.h
new file mode 100644
index 0000000..3aa594b
--- /dev/null
+++ b/dm/gfx/nvn/pragmata_memory.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#define PRAGMATA_MIB (UINT64_C(1) << 20)
+#define PRAGMATA_6_GIB (6144 * PRAGMATA_MIB)
+
+static inline bool pragmata_memory_mode(const char *game, const char *setting,
+                                        uint64_t working_set, uint64_t physical) {
+    if (strcmp(game, "0400C76024710000")) return false;
+    if (setting && !strcmp(setting, "0")) return false;
+    if (setting && !strcmp(setting, "1")) return true;
+    return (working_set && working_set <= PRAGMATA_6_GIB) ||
+           (physical && physical <= 8192 * PRAGMATA_MIB);
+}
+
+static inline bool pragmata_memory_pressure(uint64_t allocated, uint64_t budget,
+                                            uint64_t headroom, bool pressured) {
+    const uint64_t spare = (pressured ? 1024 : 768) * PRAGMATA_MIB;
+    return headroom < spare || (budget > spare && allocated >= budget - spare);
+}
+
+static inline uint64_t pragmata_sparse_chunk_min(bool low_memory, bool sparse) {
+    return (low_memory && sparse ? 128 : 256) * PRAGMATA_MIB;
+}
+
+static inline uint64_t pragmata_sparse_cache_bytes(bool low_memory, bool pressured) {
+    if (!low_memory) return UINT64_MAX;
+    return (pressured ? 128 : 192) * PRAGMATA_MIB;
+}
diff --git a/dm/gfx/nvn/pragmata_texture_quality.h b/dm/gfx/nvn/pragmata_texture_quality.h
new file mode 100644
index 0000000..b7b8372
--- /dev/null
+++ b/dm/gfx/nvn/pragmata_texture_quality.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <string.h>
+#include "include/nvn.h"
+
+typedef enum {
+    PRAGMATA_TEXTURE_LEGACY,
+    PRAGMATA_TEXTURE_ORIGINAL,
+    PRAGMATA_TEXTURE_MEDIUM,
+    PRAGMATA_TEXTURE_LOW,
+} pragmata_texture_quality;
+
+static inline pragmata_texture_quality pragmata_texture_mode(const char *game, const char *value) {
+    if (strcmp(game, "0400C76024710000") || !value) return PRAGMATA_TEXTURE_LEGACY;
+    if (!strcmp(value, "low")) return PRAGMATA_TEXTURE_LOW;
+    if (!strcmp(value, "medium")) return PRAGMATA_TEXTURE_MEDIUM;
+    return PRAGMATA_TEXTURE_ORIGINAL;
+}
+
+static inline unsigned pragmata_texture_mips(pragmata_texture_quality quality, unsigned target,
+                                             unsigned format, unsigned width, unsigned height,
+                                             unsigned levels) {
+    if (quality < PRAGMATA_TEXTURE_MEDIUM || target != NVN_TEXTURE_TARGET_2D || levels < 4)
+        return 0;
+    // BC1–BC5 and BC7 cover the color, normal and mask maps this path can
+    // reduce. Leave ASTC, HDR BC6, arrays and very wide/tall atlases alone.
+    if (format < NVN_FORMAT_RGB_DXT1 || format > NVN_FORMAT_BPTC_UNORM_SRGB)
+        return 0;
+    unsigned shorter = width < height ? width : height;
+    unsigned longer = width < height ? height : width;
+    if (shorter < 1024 || longer / 4 >= shorter) return 0;
+    if (quality == PRAGMATA_TEXTURE_MEDIUM) return shorter >= 2048 ? 1 : 0;
+    return shorter >= 4096 ? 2 : 1;
+}
