+static int gpu_only_pool_raw(void) {
+    static _Atomic int mode;   // 1 = infer raw reach; 2 = use the old policy for comparison
+    int current = atomic_load_explicit(&mode, memory_order_relaxed);
+    if (!current) {
+        const char *value = getenv("DM_NVN_GPU_ONLY_RAW");
+        current = value && !strcmp(value, "1") ? 2 : 1;
+        atomic_store_explicit(&mode, current, memory_order_relaxed);
+    }
+    return current == 2;
+}
