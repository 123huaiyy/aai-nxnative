+// DmPadArt.h: Fate/Samurai Remnant Edo-style touch-control glyphs.
+#ifndef DM_PAD_ART_H
+#define DM_PAD_ART_H
+#include <CoreGraphics/CoreGraphics.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum {
+    DM_ART_ATTACK = 0, // Normal Attack / Dual Katana Slash
+    DM_ART_SEAL = 1, // Command Seal / Special Action
+    DM_ART_HEAVY = 2, // Heavy Attack / Cleave
+    DM_ART_DODGE = 3, // Dodge / Swift Dash
+    DM_ART_JUMP = 4, // Jump / Ascending Leap
+    DM_ART_GUARD = 5, // Guard / Parrying Tsuba
+    DM_ART_SKILL_L = 6, // Skill / Sub-Action L
+    DM_ART_SKILL_R = 7, // Skill / Sub-Action R,
+    DM_ART_N
+};
+CGImageRef dm_pad_art(int which);
+#ifdef __cplusplus
+}
+#endif
+#endif
