+# RomFS: Koei Tecmo RDB: b6e28c40/root.rdb and system.rdb over .fdata files named by KTID.
+
+# ---- Identity ----
+title_id	0100B0701AA78000
+program_id	0100B0701AA78000
+
+# ---- App ----
+name	Fate/Samurai Remnant
+ipa	FateSamuraiRemnant.ipa
+app_category	public.app-category.action-games
+# Mobile ARPG HUD with customized Edo/Fate iconography and right-screen camera swipe
+pad_layout	style
+
+# ---- Versions ----
+build	v851968	1.3.2	main=6c46135714abb8706eee10f330f12b97	subsdk0=368f01d5cb42f06cd125dc739d036719	sdk=8618895246b420329b77746b960a66ab
+package	v851968
+shader_versions	v851968
+
+# ---- Files ----
+modules	main subsdk0 sdk
+romfs_marker	b6e28c40/root.rdb
+zip_store	.fdata:.file:.rdb:.webm:.metallib
+
+# ---- Memory ----
+mem_reserve	0x100000000
+mem_alias	0x10000000
+mem_stack	0x10000000
+app_pool	0xCD500000
+sys_resource	0x0
+mem_used	0x5000000
+
+# ---- Shader split ----
+shader_groups	/b6e28c40/=rdb
+shader_note	Fate/Samurai Remnant shaders
