diff --git a/runtime/touch_hunter.m b/runtime/touch_hunter.m
new file mode 100644
index 0000000..5623376
--- /dev/null
+++ b/runtime/touch_hunter.m
@@ -0,0 +1,115 @@
+#import <UIKit/UIKit.h>
+#import <SDL3/SDL.h>
+#include <pthread.h>
+#include <math.h>
+#include <string.h>
+#include "hle/input.h"
+#include "touch_hunter.h"
+#include "overlay.h"
+
+static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t buttons;
+static int axes[4];
+static int menuRequested;
+#define BIT(x) (1ull << (x))
+typedef struct { CGFloat x,y,r; uint64_t mask; int icon; __unsafe_unretained NSString *name; } Key;
+
+@interface HunterPad : UIView
+@end
+@implementation HunterPad {
+    NSMapTable<UITouch *, NSNumber *> *owners;
+    UITouch *leftTouch, *cameraTouch;
+    CGPoint leftPoint, cameraStart, cameraPoint;
+    Key keys[18]; int count;
+    CGFloat scale, width, height, leftEdge, rightEdge;
+    UIImage *atlas;
+}
+- (instancetype)initWithFrame:(CGRect)frame {
+    if ((self = [super initWithFrame:frame])) {
+        self.backgroundColor = UIColor.clearColor; self.multipleTouchEnabled = YES;
+        self.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+        owners = [NSMapTable strongToStrongObjectsMapTable];
+        atlas = [UIImage imageNamed:@"hunter-glyphs-atlas.png"];
+    }
+    return self;
+}
+- (void)buildKeys {
+    width=self.bounds.size.width; height=self.bounds.size.height;
+    scale=MIN(height/430.0,1.25); leftEdge=self.safeAreaInsets.left*0.5; rightEdge=width-self.safeAreaInsets.right*0.5;
+    CGFloat s=scale, b=height; count=0;
+#define ADD(X,Y,R,M,I,N) keys[count++] = (Key){(X),(Y),(R),(M),(I),(N)}
+    ADD(rightEdge-75*s,b-85*s,36*s,BIT(BTN_X),0,@"攻击 X");
+    ADD(rightEdge-150*s,b-150*s,27*s,BIT(BTN_A),2,@"攻击 A");
+    ADD(rightEdge-156*s,b-72*s,27*s,BIT(BTN_B),1,@"闪避 B");
+    ADD(rightEdge-230*s,b-78*s,24*s,BIT(BTN_Y),3,@"道具 Y");
+    ADD(rightEdge-73*s,b-185*s,26*s,BIT(BTN_R),4,@"动作 R");
+    ADD(rightEdge-225*s,b-155*s,24*s,BIT(BTN_X)|BIT(BTN_A),8,@"X + A");
+    ADD(rightEdge-230*s,b-220*s,24*s,BIT(BTN_R)|BIT(BTN_X)|BIT(BTN_A),12,@"R + X + A");
+    ADD(leftEdge+43*s,43*s,23*s,BIT(BTN_L),6,@"视角 L");
+    ADD(leftEdge+43*s,106*s,23*s,BIT(BTN_ZL),6,@"锁定 ZL");
+    ADD(rightEdge-40*s,43*s,23*s,BIT(BTN_ZR),5,@"ZR");
+    ADD(leftEdge+220*s,b-145*s,21*s,BIT(BTN_UP),9,@"狩技 ↑");
+    ADD(leftEdge+172*s,b-97*s,21*s,BIT(BTN_LEFT),9,@"狩技 ←");
+    ADD(leftEdge+268*s,b-97*s,21*s,BIT(BTN_RIGHT),9,@"狩技 →");
+    ADD(leftEdge+220*s,b-49*s,21*s,BIT(BTN_DOWN),9,@"↓");
+    ADD(width/2-46*s,27*s,19*s,BIT(BTN_MINUS),12,@"特殊 −");
+    ADD(width/2+46*s,27*s,19*s,BIT(BTN_PLUS),14,@"菜单 +");
+    ADD(width/2+100*s,27*s,19*s,0,15,@"模组");
+#undef ADD
+}
+- (void)layoutSubviews { [super layoutSubviews]; [self buildKeys]; [self setNeedsDisplay]; }
+- (void)drawRect:(CGRect)rect {
