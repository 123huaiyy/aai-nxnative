+def draw_dodge() -> Glyph:
+    g = Glyph()
+    g.arc((68, 63, 252, 247), 205, 42, color=BRASS, width=11)
+    g.polygon([(227, 65), (250, 97), (210, 94)], fill=EMBER, edge=EMBER, width=2, highlight=False)
+    g.line([(71, 133), (116, 122)], color=IRON, width=7)
