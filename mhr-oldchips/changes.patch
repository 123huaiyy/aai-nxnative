+
+def draw_estus() -> Glyph:
+    g = draw_item()
+    g.polygon([(147, 157), (174, 157), (181, 199), (160, 213), (139, 199)],
+              fill=(255, 130, 41, 230), edge=EMBER_CORE, width=4)
+    g.line([(160, 46), (160, 106)], color=EMBER_CORE, width=5)
+    g.line([(139, 132), (181, 132)], color=BONE, width=4)
+    return g
+
+
+def draw_spell() -> Glyph:
+    g = Glyph()
+    g.arc((83, 83, 237, 237), 18, 162, color=BRASS, width=6)
+    g.arc((83, 83, 237, 237), 198, 342, color=BRASS, width=6)
+    g.arc((108, 108, 212, 212), 28, 153, color=IRON, width=5)
+    g.arc((108, 108, 212, 212), 208, 333, color=IRON, width=5)
+    g.flame(160, 156, 0.58)
+    for x, y in ((160, 55), (251, 160), (160, 265), (69, 160)):
+        g.ellipse((x - 7, y - 7, x + 7, y + 7), edge=EMBER, width=3, fill=EMBER, highlight=False)
+    return g
+
+
+def draw_weapon() -> Glyph:
+    g = Glyph()
+    sword(g, x=145, top=42, bottom=247, angle=18)
+    g.arc((61, 85, 259, 273), 198, 325, color=EMBER, width=6)
+    g.polygon([(247, 211), (268, 241), (230, 237)], fill=EMBER, edge=EMBER, width=2, highlight=False)
+    return g
+
+
+def draw_tool() -> Glyph:
+    g = Glyph()
+    g.polygon([(98, 105), (130, 77), (190, 77), (222, 105), (208, 219),
+               (190, 239), (130, 239), (112, 219)], fill=(48, 39, 29, 255), width=9)
+    g.line([(130, 80), (143, 119), (177, 119), (190, 80)], color=BONE, width=7)
+    g.polygon([(140, 122), (180, 122), (189, 214), (160, 229), (131, 214)],
+              fill=(82, 55, 31, 255), edge=BRASS, width=6)
+    g.ellipse((151, 157, 169, 175), edge=EMBER, width=5, fill=EMBER)
+    g.line([(111, 139), (131, 139)], color=IRON, width=5)
+    g.line([(189, 139), (209, 139)], color=IRON, width=5)
+    return g
+
+
+def draw_pause() -> Glyph:
+    g = Glyph()
+    g.polygon([(77, 91), (243, 91), (231, 224), (89, 224)], fill=(37, 34, 29, 255), width=8)
+    g.polygon([(91, 105), (229, 105), (219, 207), (101, 207)], fill=(56, 49, 38, 255), edge=IRON, width=4)
+    g.ellipse((145, 54, 175, 84), edge=BRASS, width=6, fill=IRON)
+    for y, w in ((131, 87), (163, 68), (195, 87)):
+        g.line([(160 - w / 2, y), (160 + w / 2, y)], color=BONE if y == 163 else BRASS, width=8)
+    return g
+
+
+def draw_gesture() -> Glyph:
+    g = Glyph()
+    # A bowed, hollowed knight silhouette; simple enough to read at touch-key size.
+    g.polygon([(194, 60), (224, 82), (225, 119), (206, 147), (186, 151),
+               (164, 131), (157, 98), (171, 69)], fill=(42, 39, 34, 255), width=7)
+    g.ellipse((180, 73, 202, 96), edge=BONE, width=5, fill=IRON)
+    g.polygon([(172, 118), (204, 141), (185, 190), (160, 211), (120, 215),
+               (92, 198), (115, 173), (133, 142)], fill=(51, 45, 37, 255), width=8)
+    g.line([(151, 145), (185, 175), (213, 179)], color=BRASS, width=8)
+    g.line([(133, 205), (104, 239), (76, 239)], color=BONE, width=10)
+    g.line([(156, 207), (177, 242), (211, 242)], color=BONE, width=10)
+    g.line([(221, 122), (243, 146), (233, 174)], color=EMBER, width=5, highlight=False)
+    return g
+
+
+DRAW = {
+    "attack": draw_attack,
+    "guard": draw_guard,
+    "dodge": draw_dodge,
+    "interact": draw_interact,
+    "item": draw_item,
+    "left_weapon": draw_left_weapon,
+    "twohand": draw_twohand,
+    "lock": draw_lock,
+    "estus": draw_estus,
+    "spell": draw_spell,
+    "weapon": draw_weapon,
+    "tool": draw_tool,
+    "pause": draw_pause,
+    "gesture": draw_gesture,
+}
+
+
+def emit_sources() -> None:
+    header = '''// DmPadArt.h: Dark Souls Remastered touch-control glyphs.
+// Generated by dm/ios/tools/make_control_art.py.
+#ifndef DM_PAD_ART_H
+#define DM_PAD_ART_H
+#include <CoreGraphics/CoreGraphics.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum {
+@@ENUMS@@
+    DM_ART_N
+};
+CGImageRef dm_pad_art(int which);
+#ifdef __cplusplus
+}
+#endif
+#endif
+'''
+    body = '''// DmPadArt.m: transparent ash, old-brass and ember glyphs for Dark Souls Remastered.
+// Generated by dm/ios/tools/make_control_art.py; each image is decoded once and cached.
+#import "DmPadArt.h"
+#import <Foundation/Foundation.h>
+#import <ImageIO/ImageIO.h>
+@@DECLS@@
+static const char *const k_b64[DM_ART_N] = {
+@@TABLE@@
+};
+CGImageRef dm_pad_art(int which) {
+    static CGImageRef art[DM_ART_N];
+    static dispatch_once_t once;
+    if (which < 0 || which >= DM_ART_N) return NULL;
+    dispatch_once(&once, ^{
+        for (int i = 0; i < DM_ART_N; i++) {
+            NSString *base64 = [NSString stringWithUTF8String:k_b64[i]];
+            NSData *png = [[NSData alloc] initWithBase64EncodedString:base64 options:0];
+            if (!png) continue;
+            CGImageSourceRef src = CGImageSourceCreateWithData((__bridge CFDataRef)png, NULL);
+            if (!src) continue;
+            art[i] = CGImageSourceCreateImageAtIndex(src, 0, NULL);
+            CFRelease(src);
+        }
+    });
+    return art[which];
+}
+'''
+    enums = "\n".join(f"    {enum} = {i}, // {doc}" for i, (enum, _, doc) in enumerate(ART))
+    declarations, table = [], []
+    for enum, name, _ in ART:
+        data = (ART_DIR / f"{name}.png").read_bytes()
+        encoded = base64.b64encode(data).decode("ascii")
+        chunks = "\n".join(f'    "{encoded[i:i + 96]}"' for i in range(0, len(encoded), 96))
+        declarations.append(f"static const char *const k_{name} =\n{chunks};")
+        table.append(f"    k_{name}, // {enum}")
+    (SOURCES / "DmPadArt.h").write_text(header.replace("@@ENUMS@@", enums), encoding="utf-8", newline="\n")
+    rendered = body.replace("@@DECLS@@", "\n".join(declarations)).replace("@@TABLE@@", "\n".join(table))
+    (SOURCES / "DmPadArt.m").write_text(rendered, encoding="utf-8", newline="\n")
+
+
+def make_preview() -> None:
+    cell_w, cell_h = 150, 180
+    cols = 7
+    sheet = Image.new("RGB", (cell_w * cols, 45 + cell_h * 2), (17, 17, 16))
+    d = ImageDraw.Draw(sheet)
+    try:
+        title_font = ImageFont.truetype("C:/Windows/Fonts/georgiab.ttf", 22)
+        font = ImageFont.truetype("C:/Windows/Fonts/arial.ttf", 13)
+    except OSError:
+        title_font = font = ImageFont.load_default()
+    d.text((18, 11), "DARK SOULS REMASTERED  /  ASH • IRON • EMBER", font=title_font, fill=(195, 155, 91))
+    for i, (enum, name, _) in enumerate(ART):
+        col, row = i % cols, i // cols
+        x, y = col * cell_w, 45 + row * cell_h
+        d.rounded_rectangle((x + 8, y + 7, x + cell_w - 8, y + cell_h - 7), radius=17,
+                            fill=(29, 28, 26), outline=(105, 76, 39), width=2)
+        cx, cy = x + cell_w // 2, y + 72
+        d.ellipse((cx - 39, cy - 39, cx + 39, cy + 39), fill=(20, 20, 19), outline=(128, 91, 46), width=2)
+        icon = Image.open(ART_DIR / f"{name}.png").convert("RGBA")
+        icon.thumbnail((72, 72), Image.Resampling.LANCZOS)
+        sheet.paste(icon, (cx - icon.width // 2, cy - icon.height // 2), icon)
+        label = name.replace("_", " ").upper()
+        bbox = d.textbbox((0, 0), label, font=font)
+        d.text((cx - (bbox[2] - bbox[0]) / 2, y + 130), label, font=font, fill=(222, 207, 171))
+    ART_DIR.mkdir(parents=True, exist_ok=True)
+    sheet.save(ART_DIR / "preview.png")
+
+
+def main() -> None:
+    ART_DIR.mkdir(parents=True, exist_ok=True)
+    for _, name, _ in ART:
+        glyph = DRAW[name]()
+        glyph.finish().save(ART_DIR / f"{name}.png", optimize=True)
+    make_preview()
+    emit_sources()
+    print(f"drew and embedded {len(ART)} DSR glyphs in {ART_DIR}")
+
+
+if __name__ == "__main__":
+    main()
