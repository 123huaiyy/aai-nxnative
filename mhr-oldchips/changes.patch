@@ -0,0 +1,415 @@
+#!/usr/bin/env python3
+"""Draw and embed a Dark Souls Remastered control glyph set."""
+from __future__ import annotations
+
+import base64
+import io
+import math
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont, ImageFilter
+
+IOS = Path(__file__).resolve().parents[1]
+ART_DIR = IOS / "PadArt"
+SOURCES = IOS / "Sources"
+SIZE = 320
+SCALE = 4
+N = SIZE * SCALE
+
+INK = (12, 11, 10, 255)
+IRON = (69, 63, 54, 255)
+BRASS = (177, 133, 65, 255)
+BONE = (222, 207, 171, 255)
+EMBER = (245, 91, 30, 255)
+EMBER_CORE = (255, 196, 93, 255)
+
+ART = [
+    ("DM_ART_ATTACK", "attack", "Right-hand attacks"),
+    ("DM_ART_GUARD", "guard", "Guard / parry"),
+    ("DM_ART_DODGE", "dodge", "Roll / evade"),
+    ("DM_ART_INTERACT", "interact", "Action / interact"),
+    ("DM_ART_ITEM", "item", "Use item"),
+    ("DM_ART_LEFT_WEAPON", "left_weapon", "Change left-hand equipment"),
+    ("DM_ART_TWOHAND", "twohand", "One / two hand"),
+    ("DM_ART_LOCK", "lock", "Lock on / reset camera"),
+    ("DM_ART_ESTUS", "estus", "Estus Flask"),
+    ("DM_ART_SPELL", "spell", "Select spell"),
+    ("DM_ART_WEAPON", "weapon", "Change right-hand equipment"),
+    ("DM_ART_TOOL", "tool", "Select item"),
+    ("DM_ART_PAUSE", "pause", "Open menu"),
+    ("DM_ART_GESTURE", "gesture", "Gesture menu"),
+]
+
+
+class Glyph:
+    def __init__(self) -> None:
+        self.image = Image.new("RGBA", (N, N), (0, 0, 0, 0))
+        self.draw = ImageDraw.Draw(self.image)
+
+    def p(self, xy: tuple[float, float]) -> tuple[int, int]:
+        return (round(xy[0] * SCALE), round(xy[1] * SCALE))
+
+    def pts(self, points: list[tuple[float, float]]) -> list[tuple[int, int]]:
+        return [self.p(point) for point in points]
+
+    def line(self, points: list[tuple[float, float]], color=BRASS, width=8, highlight=True) -> None:
+        pts = self.pts(points)
+        w = max(2, round(width * SCALE))
+        self.draw.line(pts, fill=INK, width=w + 7 * SCALE, joint="curve")
+        self.draw.line(pts, fill=color, width=w, joint="curve")
+        if highlight:
+            self.draw.line(pts, fill=BONE, width=max(2, w // 3), joint="curve")
+        radius = w // 2
+        for x, y in (pts[0], pts[-1]):
+            self.draw.ellipse((x - radius, y - radius, x + radius, y + radius), fill=color)
+
+    def polygon(self, points, fill=IRON, edge=BRASS, width=8, highlight=True) -> None:
+        pts = self.pts(points)
+        self.draw.polygon(pts, fill=fill)
+        loop = pts + [pts[0]]
+        self.draw.line(loop, fill=INK, width=round((width + 7) * SCALE), joint="curve")
+        self.draw.line(loop, fill=edge, width=round(width * SCALE), joint="curve")
+        if highlight:
+            self.draw.line(loop, fill=BONE, width=max(2, round(width * SCALE / 3)), joint="curve")
+
+    def ellipse(self, box, edge=BRASS, width=8, fill=None, highlight=True) -> None:
+        b = tuple(round(v * SCALE) for v in box)
+        w = round(width * SCALE)
+        if fill is not None:
+            self.draw.ellipse(b, fill=fill)
+        self.draw.ellipse(b, outline=INK, width=w + 7 * SCALE)
+        self.draw.ellipse(b, outline=edge, width=w)
+        if highlight:
+            inset = max(2, round(width * SCALE * 0.55))
+            self.draw.arc((b[0] + inset, b[1] + inset, b[2] - inset, b[3] - inset), 198, 326,
+                          fill=BONE, width=max(2, w // 3))
+
+    def arc(self, box, start, end, color=BRASS, width=8) -> None:
+        b = tuple(round(v * SCALE) for v in box)
+        w = round(width * SCALE)
+        self.draw.arc(b, start, end, fill=INK, width=w + 7 * SCALE)
+        self.draw.arc(b, start, end, fill=color, width=w)
+        self.draw.arc(b, start, end, fill=BONE, width=max(2, w // 3))
+
+    def flame(self, x=160, y=134, scale=1.0) -> None:
+        outer = [(x, y + 62 * scale), (x - 42 * scale, y + 20 * scale),
+                 (x - 29 * scale, y - 18 * scale), (x - 8 * scale, y + 2 * scale),
+                 (x + 9 * scale, y - 58 * scale), (x + 27 * scale, y - 18 * scale),
+                 (x + 45 * scale, y + 15 * scale)]
+        glow = Image.new("RGBA", (N, N), (0, 0, 0, 0))
+        gd = ImageDraw.Draw(glow)
+        gd.polygon(self.pts(outer), fill=(EMBER[0], EMBER[1], EMBER[2], 150))
+        glow = glow.filter(ImageFilter.GaussianBlur(7 * SCALE))
+        self.image.alpha_composite(glow)
+        self.draw = ImageDraw.Draw(self.image)
+        self.polygon(outer, fill=EMBER, edge=EMBER, width=5, highlight=False)
+        inner = [(x, y + 38 * scale), (x - 16 * scale, y + 8 * scale),
+                 (x - 4 * scale, y - 12 * scale), (x + 8 * scale, y + 3 * scale),
+                 (x + 18 * scale, y - 24 * scale), (x + 25 * scale, y + 10 * scale)]
+        self.draw.polygon(self.pts(inner), fill=EMBER_CORE)
+
+    def finish(self) -> Image.Image:
+        return self.image.resize((SIZE, SIZE), Image.Resampling.LANCZOS)
+
+
+def sword(g: Glyph, x=160, top=45, bottom=236, angle=0.0, two_handed=False) -> None:
+    # Draw the sword around its own axis, then rotate the small transparent layer.
+    layer = Image.new("RGBA", (N, N), (0, 0, 0, 0))
+    d = Glyph()
+    blade = [(x, top), (x + 22, 142), (x, 132), (x - 22, 142)]
+    d.polygon(blade, fill=(112, 106, 92, 255), edge=BRASS, width=6)
+    d.line([(x, top + 7), (x, 125)], color=BONE, width=3)
+    d.polygon([(x - 49, 148), (x + 49, 148), (x + 35, 163), (x - 35, 163)],
+              fill=IRON, edge=BRASS, width=7)
+    d.line([(x, 158), (x, bottom - 16)], color=BRASS, width=13)
+    if two_handed:
+        d.line([(x - 23, 186), (x + 23, 186)], color=BONE, width=9)
+        d.line([(x - 23, 209), (x + 23, 209)], color=BONE, width=9)
+    d.ellipse((x - 13, bottom - 18, x + 13, bottom + 8), edge=BRASS, width=7, fill=IRON)
+    rotated = d.image.rotate(angle, resample=Image.Resampling.BICUBIC, center=(N // 2, N // 2))
+    g.image.alpha_composite(rotated)
+    g.draw = ImageDraw.Draw(g.image)
+
+
+def draw_attack() -> Glyph:
+    g = Glyph()
+    sword(g, top=34, bottom=244)
+    g.line([(82, 112), (129, 95)], color=EMBER, width=6, highlight=False)
