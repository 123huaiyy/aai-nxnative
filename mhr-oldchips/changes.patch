+
+def draw_interact() -> Glyph:
+    g = Glyph()
+    # A bonfire with a sword driven through the coals: the game's most recognizable rest/action symbol.
+    g.line([(160, 64), (160, 219)], color=BRASS, width=10)
+    g.polygon([(146, 77), (160, 39), (174, 77)], fill=(119, 110, 91, 255), edge=BRASS, width=5)
