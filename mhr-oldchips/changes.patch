diff --git a/dm/gfx/nvn/nvn_legacy_commands.h b/dm/gfx/nvn/nvn_legacy_commands.h
new file mode 100644
index 0000000000000000000000000000000000000000..1d44a4c72236631643847d563017ce1503b104d9
--- /dev/null
+++ b/dm/gfx/nvn/nvn_legacy_commands.h
@@ -0,0 +1,30 @@
+#pragma once
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+// Experimental classic-Metal submission primitive, usable on iOS 18.
+// Called from one submission thread; one encoder may be open at a time.
+// This is not yet connected to the NVN renderer or game resource bindings.
+@interface NVNLegacyCommands : NSObject
+- (instancetype)initWithDevice:(id<MTLDevice>)device;
+- (BOOL)begin;
+- (id<MTLRenderCommandEncoder>)beginRender:(MTLRenderPassDescriptor *)pass;
+- (id<MTLBlitCommandEncoder>)beginBlit;
+- (id<MTLComputeCommandEncoder>)beginCompute;
+- (BOOL)endEncoder;
+- (BOOL)commit:(void (^)(id<MTLCommandBuffer> buffer))completion;
+@end
+
+typedef NS_ENUM(NSInteger, NVNLegacyShaderStage) {
+    NVNLegacyShaderStageVertex,
+    NVNLegacyShaderStageFragment,
+    NVNLegacyShaderStageCompute,
+};
+// Bind the already-encoded shader argument buffer to a classic encoder.
+// Indirect resources still need separate residency declarations by the caller.
+BOOL nvn_legacy_bind_buffer(id<MTLCommandEncoder> encoder, NVNLegacyShaderStage stage,
+                            id<MTLBuffer> buffer, NSUInteger offset, NSUInteger index);
+// Declare indirect resources used through an argument buffer. Samplers do not
+// implement MTLResource and do not need a useResource declaration.
+BOOL nvn_legacy_use_resource(id<MTLCommandEncoder> encoder, NVNLegacyShaderStage stage,
+                             id resource, MTLResourceUsage usage);
diff --git a/dm/gfx/nvn/nvn_legacy_commands.m b/dm/gfx/nvn/nvn_legacy_commands.m
new file mode 100644
index 0000000000000000000000000000000000000000..e5423fc5a4868ae724d1345ef0efd8872f6178c6
--- /dev/null
+++ b/dm/gfx/nvn/nvn_legacy_commands.m
@@ -0,0 +1,90 @@
+#import "nvn_legacy_commands.h"
+
+@implementation NVNLegacyCommands {
+    id<MTLCommandQueue> _queue;
+    id<MTLCommandBuffer> _command;
+    id<MTLCommandEncoder> _encoder;
+}
+- (instancetype)initWithDevice:(id<MTLDevice>)device {
+    if (!device) return nil;
+    if ((self = [super init])) {
+        _queue = [device newCommandQueue];
+        if (!_queue) return nil;
+    }
+    return self;
+}
+- (BOOL)begin {
+    if (_command) return NO;
+    _command = [_queue commandBuffer];
+    return _command != nil;
+}
+- (id<MTLRenderCommandEncoder>)beginRender:(MTLRenderPassDescriptor *)pass {
+    if (!_command || _encoder || !pass) return nil;
+    id<MTLRenderCommandEncoder> encoder = [_command renderCommandEncoderWithDescriptor:pass];
+    _encoder = encoder;
+    return encoder;
+}
+- (id<MTLBlitCommandEncoder>)beginBlit {
+    if (!_command || _encoder) return nil;
+    id<MTLBlitCommandEncoder> encoder = [_command blitCommandEncoder];
+    _encoder = encoder;
+    return encoder;
+}
+- (id<MTLComputeCommandEncoder>)beginCompute {
+    if (!_command || _encoder) return nil;
+    id<MTLComputeCommandEncoder> encoder = [_command computeCommandEncoder];
+    _encoder = encoder;
+    return encoder;
+}
+- (BOOL)endEncoder {
+    if (!_encoder) return NO;
+    [_encoder endEncoding];
+    _encoder = nil;
+    return YES;
+}
+- (BOOL)commit:(void (^)(id<MTLCommandBuffer>))completion {
+    if (!_command || _encoder) return NO;
+    id<MTLCommandBuffer> command = _command;
+    _command = nil;
+    if (completion) [command addCompletedHandler:completion];
+    [command commit];
+    return YES;
+}
+@end
+
+BOOL nvn_legacy_bind_buffer(id<MTLCommandEncoder> encoder, NVNLegacyShaderStage stage,
+                            id<MTLBuffer> buffer, NSUInteger offset, NSUInteger index) {
+    if (!encoder || !buffer || offset >= buffer.length || index >= 31) return NO;
+    switch (stage) {
+        case NVNLegacyShaderStageVertex:
+            if (![encoder conformsToProtocol:@protocol(MTLRenderCommandEncoder)]) return NO;
+            [(id<MTLRenderCommandEncoder>)encoder setVertexBuffer:buffer offset:offset atIndex:index];
+            return YES;
+        case NVNLegacyShaderStageFragment:
+            if (![encoder conformsToProtocol:@protocol(MTLRenderCommandEncoder)]) return NO;
+            [(id<MTLRenderCommandEncoder>)encoder setFragmentBuffer:buffer offset:offset atIndex:index];
+            return YES;
+        case NVNLegacyShaderStageCompute:
+            if (![encoder conformsToProtocol:@protocol(MTLComputeCommandEncoder)]) return NO;
+            [(id<MTLComputeCommandEncoder>)encoder setBuffer:buffer offset:offset atIndex:index];
+            return YES;
+    }
+    return NO;
+}
+
+BOOL nvn_legacy_use_resource(id<MTLCommandEncoder> encoder, NVNLegacyShaderStage stage,
+                             id resource, MTLResourceUsage usage) {
+    if (!encoder || !resource) return NO;
+    if ([resource conformsToProtocol:@protocol(MTLSamplerState)]) return YES;
+    if (![resource conformsToProtocol:@protocol(MTLResource)]) return NO;
+    if (stage == NVNLegacyShaderStageCompute) {
+        if (![encoder conformsToProtocol:@protocol(MTLComputeCommandEncoder)]) return NO;
+        [(id<MTLComputeCommandEncoder>)encoder useResource:(id<MTLResource>)resource usage:usage];
+        return YES;
+    }
+    if ((stage != NVNLegacyShaderStageVertex && stage != NVNLegacyShaderStageFragment) ||
+        ![encoder conformsToProtocol:@protocol(MTLRenderCommandEncoder)]) return NO;
+    MTLRenderStages stages = stage == NVNLegacyShaderStageVertex ? MTLRenderStageVertex : MTLRenderStageFragment;
+    [(id<MTLRenderCommandEncoder>)encoder useResource:(id<MTLResource>)resource usage:usage stages:stages];
+    return YES;
+}
