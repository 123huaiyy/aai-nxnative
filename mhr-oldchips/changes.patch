diff --git a/dm/gfx/tex/tests/bc_decode_test.c b/dm/gfx/tex/tests/bc_decode_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..733de47df98170b6aec40a698408c06053a00017
--- /dev/null
+++ b/dm/gfx/tex/tests/bc_decode_test.c
@@ -0,0 +1,71 @@
+#include "../bc_decode.h"
+#include <stdio.h>
+#include <string.h>
+
+int main(void) {
+    // RGB565 red and green endpoints, all pixels select red.
+    const uint8_t red_bc1[8] = {0x00, 0xf8, 0xe0, 0x07, 0, 0, 0, 0};
+    uint8_t output[3 * 5 * 4 + 8];
+    uint8_t blocks[16];
+    memcpy(blocks, red_bc1, 8);
+    memcpy(blocks + 8, red_bc1, 8);
+    memset(output, 0xa5, sizeof output);
+    if (!bc_decode(0x41, blocks, 3, 5, output)) return 1;
+    for (unsigned i = 0; i < 15; i++) {
+        if (output[i * 4] != 255 || output[i * 4 + 1] != 0 ||
+            output[i * 4 + 2] != 0 || output[i * 4 + 3] != 255) return 2;
+    }
+    for (unsigned i = 60; i < sizeof output; i++) if (output[i] != 0xa5) return 3;
+    if (bc_decode(0x51, blocks, 3, 5, output)) return 4;
+    if (bc_decode(0x41, blocks, 0, 5, output)) return 5;
+    // BC2 explicit 4-bit alpha, and BC3 interpolated alpha.
+    const uint8_t bc2[16] = {
+        0x88, 0x88, 0x88, 0x88, 0x88, 0x88, 0x88, 0x88,
+        0x00, 0xf8, 0xe0, 0x07, 0, 0, 0, 0
+    };
+    const uint8_t bc3[16] = {
+        127, 0, 0, 0, 0, 0, 0, 0,
+        0x00, 0xf8, 0xe0, 0x07, 0, 0, 0, 0
+    };
+    if (!bc_decode(0x43, bc2, 4, 4, (uint8_t[64]){0})) return 6;
+    uint8_t rgba[64];
+    if (!bc_decode(0x47, bc2, 4, 4, rgba)) return 7;
+    for (unsigned i = 0; i < 16; i++)
+        if (rgba[i * 4] != 255 || rgba[i * 4 + 3] != 136) return 8;
+    if (!bc_decode(0x48, bc3, 4, 4, rgba)) return 9;
+    for (unsigned i = 0; i < 16; i++)
+        if (rgba[i * 4] != 255 || rgba[i * 4 + 3] != 127) return 10;
+    const uint8_t bc7[16] = {0};
+    memset(rgba, 0xa5, sizeof rgba);
+    if (!bc_decode(0x4d, bc7, 4, 4, rgba)) return 11;
+    for (unsigned i = 0; i < sizeof rgba; i++) if (rgba[i] != 0) return 12;
+    const uint8_t bc4[8] = {127, 0, 0, 0, 0, 0, 0, 0};
+    if (!bc_decode(0x49, bc4, 4, 4, rgba)) return 13;
+    for (unsigned i = 0; i < 16; i++)
+        if (rgba[i * 4] != 127 || rgba[i * 4 + 1] || rgba[i * 4 + 2] || rgba[i * 4 + 3] != 255) return 14;
+    const uint8_t bc5[16] = {0x81, 0, 0, 0, 0, 0, 0, 0, 0x7f, 0, 0, 0, 0, 0, 0, 0};
+    if (!bc_decode(0x4c, bc5, 4, 4, rgba)) return 15;
+    for (unsigned i = 0; i < 16; i++)
+        if (rgba[i * 4] != 0x81 || rgba[i * 4 + 1] != 0x7f || rgba[i * 4 + 3] != 0x7f) return 16;
+    const uint8_t bc6[16] = {0};
+    uint16_t hdr[64];
+    if (!bc_decode(0x50, bc6, 4, 4, hdr)) return 17;
+    for (unsigned i = 0; i < 16; i++)
+        if (hdr[i * 4] || hdr[i * 4 + 1] || hdr[i * 4 + 2] || hdr[i * 4 + 3] != 0x3c00) return 18;
+    if (bc_decoded_pixel_size(0x4f) != 8 || bc_decoded_pixel_size(0x49) != 4 ||
+        bc_decoded_pixel_size(0x51) != 0) return 19;
+    if (bc_decoded_metal_format(0x41) != 70 || bc_decoded_metal_format(0x48) != 71 ||
+        bc_decoded_metal_format(0x4a) != 72 || bc_decoded_metal_format(0x4f) != 115 ||
+        bc_decoded_metal_format(0x51) != 0) return 25;
+    uint8_t compressed[4 * 3 * 8], copied[48];
+    for (unsigned i = 0; i < sizeof compressed; i++) compressed[i] = (uint8_t)i;
+    memset(copied, 0xa5, sizeof copied);
+    if (!bc_copy_blocks(compressed, 4, 3, 1, 1, 2, 2, 8, copied, 24)) return 20;
+    if (memcmp(copied, compressed + 40, 16) || memcmp(copied + 24, compressed + 72, 16)) return 21;
+    for (unsigned i = 16; i < 24; i++) if (copied[i] != 0xa5) return 22;
+    if (bc_copy_blocks(compressed, 4, 3, 3, 1, 2, 2, 8, copied, 24)) return 23;
+    if (bc_copy_blocks(compressed, 4, 3, 1, 1, 2, 2, 8, copied, 15)) return 24;
+    puts("BC decoder smoke test passed");
+    return 0;
+}
+
diff --git a/dm/gfx/tex/tests/bc_texture_test.c b/dm/gfx/tex/tests/bc_texture_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..0c83bf650f494e3a24b86649a9d3c466a46d166e
--- /dev/null
+++ b/dm/gfx/tex/tests/bc_texture_test.c
@@ -0,0 +1,69 @@
+#include "../bc_texture.h"
+#include "../nvn_deswizzle.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(void) {
+    nvn_texdesc d = {0};
+    d.target = 4; d.format = 0x42; d.width = 7; d.height = 5; d.depth = 2; d.levels = 2;
+    nvn_texlayout layout;
+    nvn_tex_layout(&d, &layout);
+    uint8_t *storage = calloc(1, layout.size);
+    if (!storage) return 1;
+    const uint8_t red[8] = {0x00, 0xf8, 0xe0, 0x07, 0, 0, 0, 0};
+    uint8_t blocks[32];
+    for (unsigned i = 0; i < 4; i++) memcpy(blocks + i * 8, red, 8);
+    if (nvn_swizzle(&d, 0, 1, blocks, 16, storage)) return 2;
+    uint8_t pixels[7 * 5 * 4 + 8];
+    memset(pixels, 0xa5, sizeof pixels);
+    if (nvn_bc_texture_decode(&d, 0, 1, storage, layout.size, pixels, sizeof pixels - 8)) return 3;
+    for (unsigned i = 0; i < 35; i++)
+        if (pixels[i * 4] != 255 || pixels[i * 4 + 1] || pixels[i * 4 + 2] || pixels[i * 4 + 3] != 255) return 4;
+    for (unsigned i = sizeof pixels - 8; i < sizeof pixels; i++) if (pixels[i] != 0xa5) return 5;
+    if (!nvn_bc_texture_decode(&d, 0, 1, storage, layout.size - 1, pixels, sizeof pixels)) return 6;
+    if (!nvn_bc_texture_decode(&d, 0, 1, storage, layout.size, pixels, sizeof pixels - 9)) return 7;
+    if (nvn_swizzle(&d, 1, 0, red, 8, storage)) return 8;
+    if (nvn_bc_texture_decode(&d, 1, 0, storage, layout.size, pixels, sizeof pixels)) return 9;
+    for (unsigned i = 0; i < 3 * 2; i++) if (pixels[i * 4] != 255 || pixels[i * 4 + 3] != 255) return 10;
+    free(storage);
+    // Sparse layouts pad tile rows, and a 3D texture contains several depth slices.
+    d.target = 2; d.format = 0x42; d.flags = 0x20; d.width = 129; d.height = 65; d.depth = 3; d.levels = 1;
+    nvn_tex_layout(&d, &layout);
+    storage = calloc(1, layout.size);
+    size_t blocks_w = (d.width + 3) / 4, blocks_h = (d.height + 3) / 4;
+    size_t block_slice = blocks_w * blocks_h * 8, pixel_slice = (size_t)d.width * d.height * 4;
+    uint8_t *large_blocks = malloc(block_slice * d.depth);
+    uint8_t *large_pixels = malloc(pixel_slice * d.depth + 16);
+    if (!storage || !large_blocks || !large_pixels) return 11;
+    for (size_t i = 0; i < block_slice * d.depth; i += 8) memcpy(large_blocks + i, red, 8);
+    memset(large_pixels, 0xa5, pixel_slice * d.depth + 16);
+    if (nvn_swizzle(&d, 0, 0, large_blocks, blocks_w * 8, storage)) return 12;
+    if (nvn_bc_texture_decode(&d, 0, 0, storage, layout.size, large_pixels, pixel_slice * d.depth)) return 13;
+    for (size_t i = 0; i < (size_t)d.width * d.height * d.depth; i++)
+        if (large_pixels[i * 4] != 255 || large_pixels[i * 4 + 1] ||
+            large_pixels[i * 4 + 2] || large_pixels[i * 4 + 3] != 255) return 14;
+    for (size_t i = 0; i < 16; i++) if (large_pixels[pixel_slice * d.depth + i] != 0xa5) return 15;
+    free(storage); free(large_blocks); free(large_pixels);
+    // A linear 2D texture has pitched BC rows, not a Tegra tiled layout.
+    memset(&d, 0, sizeof d);
+    d.target = 1; d.format = 0x42; d.flags = 0x10;
+    d.width = 7; d.height = 5; d.depth = 1; d.levels = 1; d.stride = 32;
+    nvn_tex_layout(&d, &layout);
+    storage = calloc(1, layout.size);
+    if (!storage) return 16;
+    for (int y = 0; y < 2; y++) for (int x = 0; x < 2; x++)
+        memcpy(storage + y * d.stride + x * 8, red, 8);
+    memset(pixels, 0xa5, sizeof pixels);
+    if (nvn_bc_texture_decode(&d, 0, 0, storage, layout.size, pixels, sizeof pixels - 8)) return 17;
+    for (unsigned i = 0; i < 35; i++)
+        if (pixels[i * 4] != 255 || pixels[i * 4 + 1] || pixels[i * 4 + 2] || pixels[i * 4 + 3] != 255) return 18;
+    for (unsigned i = sizeof pixels - 8; i < sizeof pixels; i++) if (pixels[i] != 0xa5) return 19;
+    if (!nvn_bc_texture_decode(&d, 0, 0, storage, layout.size - 1, pixels, sizeof pixels)) return 20;
+    d.stride = 8;
+    if (!nvn_bc_texture_decode(&d, 0, 0, storage, layout.size, pixels, sizeof pixels)) return 21;
+    free(storage);
+    puts("BC swizzle and decode test passed");
+    return 0;
+}
