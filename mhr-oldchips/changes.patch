+// Input is an array of linear 4x4 blocks. Output is RGBA8 or RGBA16F for BC6H.
+unsigned bc_decoded_pixel_size(uint32_t format);
+// Metal format for the decoded surface. Zero means this is not a BC format.
+uint32_t bc_decoded_metal_format(uint32_t format);
+bool bc_decode(uint32_t format, const uint8_t *blocks,
+               uint32_t width, uint32_t height, void *pixels);
+
+// Copy an aligned rectangle of compressed blocks between linear surfaces.
+bool bc_copy_blocks(const uint8_t *src, uint32_t src_width_blocks, uint32_t src_height_blocks,
+                    uint32_t x, uint32_t y, uint32_t width, uint32_t height,
+                    uint32_t bytes_per_block, uint8_t *dst, size_t dst_row_stride);
diff --git a/dm/gfx/tex/bc_texture.c b/dm/gfx/tex/bc_texture.c
new file mode 100644
index 0000000000000000000000000000000000000000..ea199bedde692e8e68c82618c403680016119019
--- /dev/null
+++ b/dm/gfx/tex/bc_texture.c
@@ -0,0 +1,63 @@
+#include "bc_texture.h"
+#include "bc_decode.h"
+#include "nvn_deswizzle.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+int nvn_bc_texture_decode(const nvn_texdesc *d, unsigned level, unsigned layer,
+                          const void *storage, size_t storage_size, void *pixels, size_t pixels_size) {
+    if (!d || !storage || !pixels || level >= (d->levels ? d->levels : 1) || level >= 32 ||
+        !d->width || !d->height || !bc_decoded_pixel_size(d->format)) return -1;
+    nvn_texlayout layout;
+    nvn_tex_layout(d, &layout);
+    if (layer >= layout.layers || layout.size > storage_size) return -1;
+    // Linear NVN layouts use pitched rows of compressed blocks; the allocation
+    // is counted in pixel rows, but only ceil(height/4) block rows hold data.
+    if (d->flags & 0x50) {
+        if (d->target != 1 || level || layer || d->levels > 1 || d->samples > 1) return -1;
+        int bw, bh, bytes = nvn_fmt_bpb(d->format, &bw, &bh);
+        if (bytes <= 0 || bw != 4 || bh != 4) return -1;
+        size_t block_columns = ((size_t)d->width + 3) / 4;
+        size_t block_rows = ((size_t)d->height + 3) / 4;
+        if (block_columns > SIZE_MAX / (size_t)bytes) return -1;
+        size_t row_bytes = block_columns * (size_t)bytes;
+        size_t stride = (size_t)(layout.layer_size / d->height);
+        if (stride < row_bytes || block_rows > SIZE_MAX / row_bytes ||
+            (block_rows - 1) > (SIZE_MAX - row_bytes) / stride ||
+            (block_rows - 1) * stride + row_bytes > storage_size) return -1;
+        unsigned pixel_size = bc_decoded_pixel_size(d->format);
+        if ((size_t)d->width > SIZE_MAX / pixel_size / d->height ||
+            (size_t)d->width * d->height * pixel_size > pixels_size) return -1;
+        uint8_t *blocks = malloc(row_bytes * block_rows);
+        if (!blocks) return -1;
+        for (size_t row = 0; row < block_rows; row++)
+            memcpy(blocks + row * row_bytes, (const uint8_t *)storage + row * stride, row_bytes);
+        int ok = bc_decode(d->format, blocks, d->width, d->height, pixels);
+        free(blocks);
+        return ok ? 0 : -1;
+    }
+    uint32_t row, rows, slices, bpb;
+    uint64_t base;
+    unsigned tile_h, tile_d;
+    if (nvn_deswizzle_geom(d, level, layer, &row, &rows, &slices, &base, &tile_h, &tile_d, &bpb))
+        return -1;
+    uint32_t width = d->width >> level;
+    uint32_t height = (d->target == 0 || d->target == 3) ? 1 : d->height >> level;
+    if (!width) width = 1;
+    if (!height) height = 1;
+    unsigned pixel_size = bc_decoded_pixel_size(d->format);
+    if ((uint64_t)width > SIZE_MAX / pixel_size / height) return -1;
+    size_t slice_bytes = (size_t)width * height * pixel_size;
+    if (!slices || slice_bytes > SIZE_MAX / slices || slice_bytes * slices > pixels_size ||
+        (uint64_t)row * rows > SIZE_MAX / slices) return -1;
+    size_t compressed_slice = (size_t)row * rows;
+    uint8_t *blocks = malloc(compressed_slice * slices);
+    if (!blocks) return -1;
+    int result = nvn_deswizzle(d, level, layer, storage, blocks, row);
+    for (uint32_t z = 0; !result && z < slices; z++)
+        if (!bc_decode(d->format, blocks + z * compressed_slice, width, height,
+                       (uint8_t *)pixels + z * slice_bytes)) result = -1;
+    free(blocks);
+    return result;
+}
