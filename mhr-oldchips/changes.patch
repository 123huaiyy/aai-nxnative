diff --git a/dm/gfx/nvn/nvn_legacy_commands.h b/dm/gfx/nvn/nvn_legacy_commands.h
new file mode 100644
index 0000000000000000000000000000000000000000..92c822f22d598d8b4da5299a434988cf2f62f106
--- /dev/null
+++ b/dm/gfx/nvn/nvn_legacy_commands.h
@@ -0,0 +1,16 @@
+#pragma once
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+// Experimental classic-Metal submission primitive, usable on iOS 18.
+// Called from one submission thread; one encoder may be open at a time.
+// This is not yet connected to the NVN renderer or game resource bindings.
+@interface NVNLegacyCommands : NSObject
+- (instancetype)initWithDevice:(id<MTLDevice>)device;
+- (BOOL)begin;
+- (id<MTLRenderCommandEncoder>)beginRender:(MTLRenderPassDescriptor *)pass;
+- (id<MTLBlitCommandEncoder>)beginBlit;
+- (id<MTLComputeCommandEncoder>)beginCompute;
+- (BOOL)endEncoder;
+- (BOOL)commit:(void (^)(id<MTLCommandBuffer> buffer))completion;
+@end
diff --git a/dm/gfx/nvn/nvn_legacy_commands.m b/dm/gfx/nvn/nvn_legacy_commands.m
new file mode 100644
index 0000000000000000000000000000000000000000..f67ad832bf0ace67dd253f20006d0313dc21023e
--- /dev/null
+++ b/dm/gfx/nvn/nvn_legacy_commands.m
@@ -0,0 +1,53 @@
+#import "nvn_legacy_commands.h"
+
+@implementation NVNLegacyCommands {
+    id<MTLCommandQueue> _queue;
+    id<MTLCommandBuffer> _command;
+    id<MTLCommandEncoder> _encoder;
+}
+- (instancetype)initWithDevice:(id<MTLDevice>)device {
+    if (!device) return nil;
+    if ((self = [super init])) {
+        _queue = [device newCommandQueue];
+        if (!_queue) return nil;
+    }
+    return self;
+}
+- (BOOL)begin {
+    if (_command) return NO;
+    _command = [_queue commandBuffer];
+    return _command != nil;
+}
+- (id<MTLRenderCommandEncoder>)beginRender:(MTLRenderPassDescriptor *)pass {
+    if (!_command || _encoder || !pass) return nil;
+    id<MTLRenderCommandEncoder> encoder = [_command renderCommandEncoderWithDescriptor:pass];
+    _encoder = encoder;
+    return encoder;
+}
+- (id<MTLBlitCommandEncoder>)beginBlit {
+    if (!_command || _encoder) return nil;
+    id<MTLBlitCommandEncoder> encoder = [_command blitCommandEncoder];
+    _encoder = encoder;
+    return encoder;
+}
+- (id<MTLComputeCommandEncoder>)beginCompute {
+    if (!_command || _encoder) return nil;
+    id<MTLComputeCommandEncoder> encoder = [_command computeCommandEncoder];
+    _encoder = encoder;
+    return encoder;
+}
+- (BOOL)endEncoder {
+    if (!_encoder) return NO;
+    [_encoder endEncoding];
+    _encoder = nil;
+    return YES;
+}
+- (BOOL)commit:(void (^)(id<MTLCommandBuffer>))completion {
+    if (!_command || _encoder) return NO;
+    id<MTLCommandBuffer> command = _command;
+    _command = nil;
+    if (completion) [command addCompletedHandler:completion];
+    [command commit];
+    return YES;
+}
+@end
diff --git a/dm/gfx/nvn/nvn_legacy_pass.h b/dm/gfx/nvn/nvn_legacy_pass.h
new file mode 100644
index 0000000000000000000000000000000000000000..423e79aeb9955107cfca8d8138a0111b2be1a72e
--- /dev/null
+++ b/dm/gfx/nvn/nvn_legacy_pass.h
@@ -0,0 +1,7 @@
+#pragma once
+#import <Metal/Metal.h>
+
+// Prepare a classic Metal pass from an NVN replay pass. This only translates
+// the descriptor; it does not implement the classic NVN command backend.
+// Nil means that the pass uses an action which requires additional handling.
+MTLRenderPassDescriptor *nvn_legacy_pass(MTL4RenderPassDescriptor *source);
diff --git a/dm/gfx/nvn/nvn_legacy_pass.m b/dm/gfx/nvn/nvn_legacy_pass.m
new file mode 100644
index 0000000000000000000000000000000000000000..cdf07074a9af8f361ccbce6ee918e14953455a73
--- /dev/null
+++ b/dm/gfx/nvn/nvn_legacy_pass.m
@@ -0,0 +1,41 @@
+#import "nvn_legacy_pass.h"
+
+static BOOL copy_attachment(MTLRenderPassAttachmentDescriptor *dst,
+                            MTLRenderPassAttachmentDescriptor *src) {
+    // Unknown is resolved dynamically by Metal 4's encoder. Until classic
+    // encoder store-action tracking exists, fail rather than discard output.
+    if (src.texture && src.storeAction == MTLStoreActionUnknown) return NO;
+    dst.texture = src.texture;
+    dst.level = src.level;
+    dst.slice = src.slice;
+    dst.depthPlane = src.depthPlane;
+    dst.resolveTexture = src.resolveTexture;
+    dst.resolveLevel = src.resolveLevel;
+    dst.resolveSlice = src.resolveSlice;
+    dst.resolveDepthPlane = src.resolveDepthPlane;
+    dst.loadAction = src.loadAction;
+    dst.storeAction = src.storeAction;
+    dst.storeActionOptions = src.storeActionOptions;
+    return YES;
+}
+
+MTLRenderPassDescriptor *nvn_legacy_pass(MTL4RenderPassDescriptor *source) {
+    if (!source) return nil;
+    MTLRenderPassDescriptor *out = [MTLRenderPassDescriptor renderPassDescriptor];
+    for (NSUInteger i = 0; i < 8; i++) {
+        if (!copy_attachment(out.colorAttachments[i], source.colorAttachments[i])) return nil;
+        out.colorAttachments[i].clearColor = source.colorAttachments[i].clearColor;
+    }
+    if (!copy_attachment(out.depthAttachment, source.depthAttachment) ||
+        !copy_attachment(out.stencilAttachment, source.stencilAttachment)) return nil;
+    out.depthAttachment.clearDepth = source.depthAttachment.clearDepth;
+    out.depthAttachment.depthResolveFilter = source.depthAttachment.depthResolveFilter;
+    out.stencilAttachment.clearStencil = source.stencilAttachment.clearStencil;
+    out.stencilAttachment.stencilResolveFilter = source.stencilAttachment.stencilResolveFilter;
+    out.renderTargetArrayLength = source.renderTargetArrayLength;
+    out.renderTargetWidth = source.renderTargetWidth;
+    out.renderTargetHeight = source.renderTargetHeight;
+    out.defaultRasterSampleCount = source.defaultRasterSampleCount;
+    out.visibilityResultBuffer = source.visibilityResultBuffer;
+    return out;
+}
diff --git a/dm/gfx/tests/t_legacy_commands.m b/dm/gfx/tests/t_legacy_commands.m
new file mode 100644
index 0000000000000000000000000000000000000000..7b1ece6ba534f28376b539e4cb3ec933732dfd52
--- /dev/null
+++ b/dm/gfx/tests/t_legacy_commands.m
@@ -0,0 +1,40 @@
+#import <Foundation/Foundation.h>
+#import "../nvn/nvn_legacy_commands.h"
+#include <stdio.h>
+
+int main(void) { @autoreleasepool {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (!device) { puts("No Metal GPU: classic command test skipped"); return 77; }
+    NVNLegacyCommands *cmd = [[NVNLegacyCommands alloc] initWithDevice:device];
+    if (!cmd || [cmd beginBlit] || [cmd endEncoder] || [cmd commit:nil] || ![cmd begin] || [cmd begin]) return 1;
+    id<MTLBuffer> buffer = [device newBufferWithLength:64 options:MTLResourceStorageModeShared];
+    id<MTLBuffer> copy = [device newBufferWithLength:64 options:MTLResourceStorageModeShared];
+    if (!buffer || !copy) return 2;
+    id<MTLBlitCommandEncoder> blit = [cmd beginBlit];
+    if (!blit || [cmd beginCompute] || [cmd commit:nil]) return 3;
+    [blit fillBuffer:buffer range:NSMakeRange(0, 64) value:0x5a];
+    [blit copyFromBuffer:buffer sourceOffset:0 toBuffer:copy destinationOffset:0 size:64];
+    if (![cmd endEncoder] || [cmd endEncoder]) return 4;
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:4 height:4 mipmapped:NO];
+    td.storageMode = MTLStorageModeShared; td.usage = MTLTextureUsageRenderTarget;
+    id<MTLTexture> texture = [device newTextureWithDescriptor:td];
+    MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = texture;
+    pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    pass.colorAttachments[0].clearColor = MTLClearColorMake(1, 0, 0, 1);
+    if (!texture || ![cmd beginRender:pass] || ![cmd endEncoder]) return 5;
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    __block MTLCommandBufferStatus status = MTLCommandBufferStatusNotEnqueued;
+    if (![cmd commit:^(id<MTLCommandBuffer> b) { status = b.status; dispatch_semaphore_signal(done); }]) return 6;
+    if (dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC)) || status != MTLCommandBufferStatusCompleted) return 7;
+    const unsigned char *bytes = copy.contents;
+    for (unsigned i = 0; i < 64; i++) if (bytes[i] != 0x5a) return 8;
+    unsigned char pixels[64];
+    [texture getBytes:pixels bytesPerRow:16 fromRegion:MTLRegionMake2D(0, 0, 4, 4) mipmapLevel:0];
+    for (unsigned i = 0; i < 16; i++)
+        if (pixels[i * 4] != 255 || pixels[i * 4 + 1] || pixels[i * 4 + 2] || pixels[i * 4 + 3] != 255) return 9;
+    if (![cmd begin] || ![cmd beginCompute] || ![cmd endEncoder] || ![cmd commit:nil]) return 10;
+    puts("Classic Metal submission, copy and clear passed");
+    return 0;
+} }
diff --git a/dm/gfx/tests/t_legacy_pass.m b/dm/gfx/tests/t_legacy_pass.m
new file mode 100644
index 0000000000000000000000000000000000000000..27abf490c03f6a3ee65753268ab4896d62368041
--- /dev/null
+++ b/dm/gfx/tests/t_legacy_pass.m
@@ -0,0 +1,57 @@
+#import <Foundation/Foundation.h>
+#include <stdio.h>
+#import "../nvn/nvn_legacy_pass.h"
+
+int main(void) { @autoreleasepool {
+    MTL4RenderPassDescriptor *source = [MTL4RenderPassDescriptor new];
+    source.colorAttachments[2].level = 3;
+    source.colorAttachments[2].slice = 5;
+    source.colorAttachments[2].loadAction = MTLLoadActionClear;
+    source.colorAttachments[2].storeAction = MTLStoreActionStore;
+    source.colorAttachments[2].clearColor = MTLClearColorMake(0.1, 0.2, 0.3, 0.4);
+    source.depthAttachment.clearDepth = 0.75;
+    source.stencilAttachment.clearStencil = 23;
+    source.renderTargetWidth = 640; source.renderTargetHeight = 480;
+    source.renderTargetArrayLength = 2; source.defaultRasterSampleCount = 1;
+    MTLRenderPassDescriptor *out = nvn_legacy_pass(source);
+    if (!out || out.colorAttachments[2].level != 3 || out.colorAttachments[2].slice != 5 ||
+        out.colorAttachments[2].loadAction != MTLLoadActionClear ||
+        out.colorAttachments[2].storeAction != MTLStoreActionStore ||
+        out.colorAttachments[2].clearColor.green != 0.2 ||
+        out.depthAttachment.clearDepth != 0.75 || out.stencilAttachment.clearStencil != 23 ||
+        out.renderTargetWidth != 640 || out.renderTargetHeight != 480 ||
+        out.renderTargetArrayLength != 2 || out.defaultRasterSampleCount != 1 || nvn_legacy_pass(nil)) return 1;
+    // Exercise the converted pass on a classic queue when this Mac has Metal.
+    // Hosted virtual machines may expose no GPU; the descriptor checks above
+    // still run there, but an actual GPU test remains necessary on a device.
+    id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+    if (dev) {
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:4 height:4 mipmapped:NO];
+        td.storageMode = MTLStorageModeShared; td.usage = MTLTextureUsageRenderTarget;
+        id<MTLTexture> texture = [dev newTextureWithDescriptor:td];
+        id<MTLCommandQueue> queue = [dev newCommandQueue];
+        if (!texture || !queue) return 2;
+        MTL4RenderPassDescriptor *draw = [MTL4RenderPassDescriptor new];
+        draw.colorAttachments[0].texture = texture;
+        draw.colorAttachments[0].loadAction = MTLLoadActionClear;
+        draw.colorAttachments[0].storeAction = MTLStoreActionStore;
+        draw.colorAttachments[0].clearColor = MTLClearColorMake(1, 0, 0, 1);
+        MTLRenderPassDescriptor *classic = nvn_legacy_pass(draw);
+        id<MTLCommandBuffer> cb = [queue commandBuffer];
+        id<MTLRenderCommandEncoder> encoder = [cb renderCommandEncoderWithDescriptor:classic];
+        if (!classic || !cb || !encoder) return 3;
+        [encoder endEncoding]; [cb commit]; [cb waitUntilCompleted];
+        if (cb.status != MTLCommandBufferStatusCompleted) return 4;
+        unsigned char pixels[4 * 4 * 4];
+        [texture getBytes:pixels bytesPerRow:16 fromRegion:MTLRegionMake2D(0, 0, 4, 4) mipmapLevel:0];
+        for (unsigned i = 0; i < 16; i++)
+            if (pixels[i * 4] != 255 || pixels[i * 4 + 1] || pixels[i * 4 + 2] || pixels[i * 4 + 3] != 255) return 5;
+        draw.colorAttachments[0].storeAction = MTLStoreActionUnknown;
+        if (nvn_legacy_pass(draw)) return 6;
+        puts("Legacy Metal clear/readback passed");
+    } else {
+        puts("No Metal GPU: clear/readback test skipped");
+    }
+    puts("Legacy Metal pass translation test passed");
+    return 0;
+} }
