+    g.line([(160, 204), (160, 267)], color=BONE, width=6)
+    g.line([(53, 160), (116, 160)], color=BONE, width=6)
+    g.line([(204, 160), (267, 160)], color=BONE, width=6)
+    g.ellipse((139, 139, 181, 181), edge=EMBER, width=7, fill=(44, 29, 21, 255))
+    g.ellipse((153, 153, 167, 167), edge=EMBER_CORE, width=3, fill=EMBER_CORE, highlight=False)
