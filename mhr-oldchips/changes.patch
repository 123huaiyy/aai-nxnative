diff --git a/dm/gfx/tests/legacy_texture_draw.metal b/dm/gfx/tests/legacy_texture_draw.metal
new file mode 100644
index 0000000000000000000000000000000000000000..5706d813a11278527c7ccd33f923547bc092fd0b
--- /dev/null
+++ b/dm/gfx/tests/legacy_texture_draw.metal
@@ -0,0 +1,20 @@
+#include <metal_stdlib>
+using namespace metal;
+
+struct LegacyVertex { float4 position [[position]]; float2 uv; };
+vertex LegacyVertex legacy_vertex(uint id [[vertex_id]]) {
+    const float2 points[3] = { float2(-1, -1), float2(3, -1), float2(-1, 3) };
+    LegacyVertex out;
+    out.position = float4(points[id], 0, 1);
+    out.uv = points[id] * 0.5f + 0.5f;
+    return out;
+}
+struct LegacyResources {
+    texture2d<float> image [[id(0)]];
+    sampler imageSampler [[id(1)]];
+};
+fragment float4 legacy_fragment(LegacyVertex in [[stage_in]],
+                                constant LegacyResources &resources [[buffer(1)]],
+                                constant float4 &tint [[buffer(0)]]) {
+    return resources.image.sample(resources.imageSampler, in.uv) * tint;
+}
