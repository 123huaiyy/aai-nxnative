@@ -164,6 +167,10 @@ $(O)/rt/forge_imgui.o: RTFLAGS += -DCIMGUI_NO_EXPORT -Wno-unused-variable
 
 $(O)/rt/platform/darwin.o: RTFLAGS += -x objective-c
 
+$(O)/rt/touch_hunter.o: runtime/touch_hunter.m runtime/touch_hunter.h
+	@mkdir -p $(dir $@)
+	$(CC) $(RTFLAGS) -fobjc-arc -c $< -o $@
+
 $(O)/rt/overlay.o: runtime/overlay.cpp runtime/overlay.h runtime/forge.h
 	@mkdir -p $(dir $@)
 	$(CXX) $(IMGUIFLAGS) $(if $(filter 1,$(NULL_GPU)),-DMHGU_NULL_BACKEND) -Wall -Iruntime -c $< -o $@
