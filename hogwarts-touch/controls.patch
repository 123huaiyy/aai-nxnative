+static UIImage *renderArt(UIImage *icon, CGFloat fill) {
+    if (!icon) return nil;
+    const CGFloat longest = MAX(icon.size.width, icon.size.height);
+    if (longest <= 0) return nil;
+    UIColor *gold = [UIColor colorWithRed:0.98 green:0.87 blue:0.62 alpha:1];
+    icon = [icon imageWithTintColor:gold renderingMode:UIImageRenderingModeAlwaysOriginal];
+    CGSize canvas = CGSizeMake(128, 128);
+    CGFloat scale = fill / longest;
+    CGSize draw = CGSizeMake(icon.size.width * scale, icon.size.height * scale);
+    UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat defaultFormat];
+    format.scale = 1;
+    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:canvas format:format];
+    return [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
+        CGContextSetShadowWithColor(context.CGContext, CGSizeMake(0, 1), 3, UIColor.blackColor.CGColor);
+        [icon drawInRect:CGRectMake((canvas.width - draw.width) / 2, (canvas.height - draw.height) / 2,
+                                      draw.width, draw.height)];
+    }];
+}
+static UIImage *bundledPadImage(NSString *name) {
+    NSString *folder = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"pad"];
+    return [UIImage imageWithContentsOfFile:[folder stringByAppendingPathComponent:[name stringByAppendingPathExtension:@"png"]]];
+}
+static CALayer *artLayer(CALayer *parent, int button) {
+    static NSString *const assets[B_N] = {
+        [B_A] = @"dodge", [B_B] = @"jump", [B_X] = @"ward", [B_Y] = @"interact",
+        [B_ZR] = @"cast", [B_ZL] = @"aim", [B_L] = @"tools", [B_R] = @"ancient",
+        [B_UP] = @"heal", [B_LEFT] = @"reveal", [B_RIGHT] = @"spells", [B_DOWN] = @"track",
+        [B_MINUS] = @"map", [B_PLUS] = @"pause",
+    };
+    UIImage *image = assets[button] ? bundledPadImage(assets[button]) : nil;
+    static NSString *const symbols[B_N] = {
+        [B_ZR] = @"wand.and.stars", [B_ZL] = @"scope", [B_L] = @"flask", [B_R] = @"sparkle",
+        [B_LEFT] = @"eye", [B_RIGHT] = @"book.closed", [B_DOWN] = @"location",
+    };
+    static const int artwork[B_N] = {
+        [B_A] = DM_ART_DODGE + 1, [B_B] = DM_ART_JUMP + 1, [B_X] = DM_ART_WARD + 1,
+        [B_Y] = DM_ART_INTERACT + 1, [B_UP] = DM_ART_VIAL_HEAL + 1,
+        [B_PLUS] = DM_ART_PAUSE + 1, [B_MINUS] = DM_ART_MAP + 1,
+    };
+    if (!image) {
+        UIImage *icon = nil;
+        if (symbols[button]) {
+            UIImageSymbolConfiguration *config = [UIImageSymbolConfiguration configurationWithPointSize:80 weight:UIImageSymbolWeightMedium];
+            icon = [UIImage systemImageNamed:symbols[button] withConfiguration:config];
+        }
+        if (!icon && artwork[button]) {
+            CGImageRef original = dm_pad_art(artwork[button] - 1);
+            if (original) icon = [UIImage imageWithCGImage:original];
+        }
+        image = renderArt(icon, symbols[button] ? 100 : 128);
+    }
+    CGImageRef glyph = image.CGImage;
+    if (!glyph) return nil;
+    CALayer *layer = [CALayer layer];
+    layer.contents = (__bridge id)glyph;
+    layer.contentsGravity = kCAGravityResizeAspect;
+    layer.opacity = K_STYLE_IDLE;
+    [parent addSublayer:layer];
+    return layer;
 }
