+
+- (void)editorPan:(UIPanGestureRecognizer *)pan {
+    CGPoint p = [pan locationInView:self];
+    if (pan.state == UIGestureRecognizerStateBegan) {
+        CGPoint delta = [pan translationInView:self];
+        CGPoint start = CGPointMake(p.x - delta.x, p.y - delta.y);
+        _editedControl = _draggedControl = [self editorControlAt:start];
+        if (_draggedControl >= 0) {
+            CGPoint center = [self editorCenter:_draggedControl];
+            _dragOffset = CGPointMake(center.x - start.x, center.y - start.y);
+        }
+        [self setNeedsLayout];
+    }
+    if (_draggedControl < 0) return;
+    if (pan.state == UIGestureRecognizerStateCancelled || pan.state == UIGestureRecognizerStateFailed) {
+        _draggedControl = -1;
+        return;
+    }
+    CGRect safe = self.safe;
+    if (!CGRectIsEmpty(safe)) {
+        CGFloat x = clamp((p.x + _dragOffset.x - CGRectGetMinX(safe)) / safe.size.width, 0, 1);
+        CGFloat y = clamp((p.y + _dragOffset.y - CGRectGetMinY(safe)) / safe.size.height, 0, 1);
+        _customPad[placementKey(_draggedControl)] = @{@"x": @(x), @"y": @(y), @"scale": @([self styleScale:_draggedControl])};
+        [self setNeedsLayout];
+    }
+    if (pan.state == UIGestureRecognizerStateEnded) _draggedControl = -1;
+}
+
+- (void)resizeEditedControl:(CGFloat)change {
+    if (_editedControl < 0) return;
+    NSString *key = placementKey(_editedControl);
+    NSMutableDictionary *placement = [_customPad[key] mutableCopy] ?: [NSMutableDictionary dictionary];
+    placement[@"scale"] = @(clamp([self styleScale:_editedControl] + change, 0.65, 1.6));
+    _customPad[key] = placement;
+    [self setNeedsLayout];
+}
+
+- (void)editorShrink { [self resizeEditedControl:-0.1]; }
+- (void)editorGrow { [self resizeEditedControl:0.1]; }
+- (void)editorReset { [_customPad removeAllObjects]; _editedControl = -1; [self setNeedsLayout]; }
+- (void)editorCancel { [self closePadEditor:NO]; }
+- (void)editorSave { [self closePadEditor:YES]; }
+
+- (void)closePadEditor:(BOOL)save {
+    if (save) [NSUserDefaults.standardUserDefaults setObject:_customPad forKey:k_custom_key];
+    else _customPad = [[NSUserDefaults.standardUserDefaults dictionaryForKey:k_custom_key] mutableCopy]
+        ?: [NSMutableDictionary dictionary];
+    [_padEditor removeFromSuperview];
+    _padEditor = nil;
+    _editorBar = nil;
+    _editorSelection = nil;
+    _editorSmaller = _editorLarger = nil;
+    _menu.hidden = NO;
+    _controls.hidden = _padOff || _hidden;
+    [self setNeedsLayout];
+}
