+- (CGPoint)editorCenter:(int)control {
+    if (control == B_MOVE_STICK) return self.stickHome;
+    if (control >= B_LEFT) return [self shortcutCenter:control];
+    if (control <= B_Y) return [self facePos:control];
+    if (isDrop(control)) return [self dropCenter:control];
+    CGRect pill = [self pillRect:control];
+    return CGPointMake(CGRectGetMidX(pill), CGRectGetMidY(pill));
+}
+
+- (CGRect)editorTarget:(int)control {
+    if (control == B_MOVE_STICK) {
+        CGFloat radius = [self stickR:0];
+        CGPoint p = self.stickHome;
+        return CGRectMake(p.x - radius, p.y - radius, 2 * radius, 2 * radius);
+    }
+    CGRect art = _art[control].frame, caption = _label[control].frame;
+    return CGRectUnion(art, caption);
+}
+
+- (int)editorControlAt:(CGPoint)p {
+    int best = -1;
+    CGFloat nearest = CGFLOAT_MAX;
+    for (int i = 0; i < (int)(sizeof k_style_editable / sizeof *k_style_editable); i++) {
+        int control = k_style_editable[i];
+        if (!CGRectContainsPoint(CGRectInset([self editorTarget:control], -10, -10), p)) continue;
+        CGFloat d = dist(p, [self editorCenter:control]);
+        if (d < nearest) { nearest = d; best = control; }
+    }
+    return best;
+}
+
+- (void)layoutPadEditor {
+    _padEditor.frame = self.bounds;
+    CGRect safe = self.safe;
+    if (CGRectIsEmpty(safe)) return;
+    CGSize barSize = [_editorBar systemLayoutSizeFittingSize:UILayoutFittingCompressedSize];
+    _editorBar.frame = CGRectMake(CGRectGetMidX(safe) - barSize.width / 2,
+                                 CGRectGetMaxY(safe) - barSize.height - 8, barSize.width, barSize.height);
+    _editorSelection.hidden = _editedControl < 0;
+    _editorSmaller.enabled = _editedControl >= 0;
+    _editorLarger.enabled = _editedControl >= 0;
+    if (_editedControl >= 0) {
+        CGRect target = CGRectInset([self editorTarget:_editedControl], -5, -5);
+        _editorSelection.path = [UIBezierPath bezierPathWithRoundedRect:target cornerRadius:8].CGPath;
+    }
+}
+
+- (UIButton *)editorButton:(NSString *)title action:(SEL)action {
+    UIButton *button = [UIButton buttonWithType:UIButtonTypeSystem];
+    UIButtonConfiguration *config = [UIButtonConfiguration plainButtonConfiguration];
+    config.title = title;
+    config.baseForegroundColor = UIColor.whiteColor;
+    config.contentInsets = NSDirectionalEdgeInsetsMake(8, 9, 8, 9);
+    button.configuration = config;
+    [button.heightAnchor constraintGreaterThanOrEqualToConstant:44].active = YES;
+    [button addTarget:self action:action forControlEvents:UIControlEventTouchUpInside];
+    return button;
+}
